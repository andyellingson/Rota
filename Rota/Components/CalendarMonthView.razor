@using System.Globalization

@* Month grid: six weeks of day cells. Day content is supplied by the owner. *@
<div class="calendar-month">
    <div class="calendar-header-tools mb-2">
        <div class="calendar-header-left">
            <div class="btn-group" role="group" aria-label="Selection mode">
                <button class="btn btn-sm @(SelectionMode == SelectionMode.Day ? "btn-primary" : "btn-outline-secondary")"
                        title="@(SelectionMode == SelectionMode.Day ? "Exit day selection mode" : "Toggle multiple day selection mode")"
                        @onclick="() => OnSelectionModeChanged.InvokeAsync(SelectionMode.Day)"
                        aria-pressed="@(SelectionMode == SelectionMode.Day)">
                    ☑ Days
                </button>
                <button class="btn btn-sm @(SelectionMode == SelectionMode.Week ? "btn-primary" : "btn-outline-secondary")"
                        title="@(SelectionMode == SelectionMode.Week ? "Exit week selection mode" : "Toggle multiple week selection mode")"
                        @onclick="() => OnSelectionModeChanged.InvokeAsync(SelectionMode.Week)"
                        aria-pressed="@(SelectionMode == SelectionMode.Week)">
                    📅 Weeks
                </button>
            </div>
        </div>
        <div class="calendar-header-center">
            <strong class="calendar-title">@Current.ToString("MMMM yyyy", CultureInfo.CurrentCulture)</strong>
        </div>
        <div class="calendar-header-actions">
            <div class="btn-group" role="group" aria-label="View mode">
                <button class="btn btn-sm @(View == ViewMode.Week ? "btn-primary" : "btn-outline-primary")"
                        title="Switch to weekly calendar view"
                        @onclick="() => OnViewChanged.InvokeAsync(ViewMode.Week)"
                        aria-pressed="@(View == ViewMode.Week)">
                    Week
                </button>
                <button class="btn btn-sm @(View == ViewMode.Month ? "btn-primary" : "btn-outline-primary")"
                        title="Switch to monthly calendar view"
                        @onclick="() => OnViewChanged.InvokeAsync(ViewMode.Month)"
                        aria-pressed="@(View == ViewMode.Month)">
                    Month
                </button>
            </div>
            <div class="month-nav" role="group" aria-label="Calendar navigation">
                <button class="btn btn-sm btn-outline-secondary" title="Go to the previous period" @onclick="OnPrev">‹</button>
                <button class="btn btn-sm btn-outline-secondary" title="Go to the next period" @onclick="OnNext">›</button>
            </div>
            <button class="btn btn-sm btn-outline-secondary" title="Open the print preview for this schedule" aria-label="Print" @onclick="OnPrint">🖨️</button>
        </div>
    </div>

    <div class="calendar-grid">
        @foreach (var name in DayNames)
        {
            <div class="calendar-grid-header">@name</div>
        }

        @foreach (var day in GetMonthDays())
        {
            var other = day.Month != Current.Month;
            var isToday = day == DateOnly.FromDateTime(DateTime.Today);
            var capturedDay = day;
            <div class="day-cell @(other ? "other-month" : "") @(isToday ? "today" : "") @(SelectedDays.Contains(day) ? "day-selected" : "")"
                 @onclick="() => OnDayClick.InvokeAsync(capturedDay)">
                <div class="day-number">@day.Day</div>
                <div class="events events-overlay">
                    @DayContent(day)
                </div>
            </div>
        }
    </div>
</div>

@code {
    /// <summary>Any date inside the month being displayed.</summary>
    [Parameter, EditorRequired] public DateOnly Current { get; set; }

    /// <summary>Days currently selected in multi-select mode.</summary>
    [Parameter] public HashSet<DateOnly> SelectedDays { get; set; } = new();

    /// <summary>Renders the entries of a single day.</summary>
    [Parameter, EditorRequired] public RenderFragment<DateOnly> DayContent { get; set; } = default!;

    /// <summary>Raised when a day cell is clicked.</summary>
    [Parameter] public EventCallback<DateOnly> OnDayClick { get; set; }

    /// <summary>Raised when the user clicks previous in the month header.</summary>
    [Parameter] public EventCallback OnPrev { get; set; }

    /// <summary>Raised when the user clicks next in the month header.</summary>
    [Parameter] public EventCallback OnNext { get; set; }

    /// <summary>Active view mode for header controls.</summary>
    [Parameter] public ViewMode View { get; set; }

    /// <summary>Raised when the user changes view mode from the header.</summary>
    [Parameter] public EventCallback<ViewMode> OnViewChanged { get; set; }

    /// <summary>Active multi-day selection mode for header controls.</summary>
    [Parameter] public SelectionMode SelectionMode { get; set; }

    /// <summary>Raised when the user changes selection mode from the header.</summary>
    [Parameter] public EventCallback<SelectionMode> OnSelectionModeChanged { get; set; }

    /// <summary>Raised when the user clicks print in the header.</summary>
    [Parameter] public EventCallback OnPrint { get; set; }

    // Day names for the header, rotated to start on the culture's first day of week.
    private static string[] DayNames
    {
        get
        {
            var format = CultureInfo.CurrentCulture.DateTimeFormat;
            var first = (int)format.FirstDayOfWeek;
            return format.AbbreviatedDayNames.Skip(first).Concat(format.AbbreviatedDayNames.Take(first)).ToArray();
        }
    }

    /// <summary>
    /// Returns the 42 days (six weeks) shown for the month, starting on the first day of the
    /// week that contains the 1st of the month.
    /// </summary>
    private IEnumerable<DateOnly> GetMonthDays()
    {
        var start = CalendarDates.StartOfWeek(new DateOnly(Current.Year, Current.Month, 1));
        return Enumerable.Range(0, 42).Select(i => start.AddDays(i));
    }
}
