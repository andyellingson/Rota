@using System.Globalization
@using Rota.Models

<div class="work-item mb-1 @(IsUnassignedFuture ? "work-item--unassigned" : "") @(IsPast ? "item--past" : "") @(IsAssignedFromAdditionalQualifiedType ? "work-item--additional-qualified" : "")"
     style="border-left-color: @(WorkItem.Color ?? "#1890ff");"
     title="@(IsAssignedFromAdditionalQualifiedType ? "Assigned via additional qualified role" : null)"
     @onclick:stopPropagation="true" @onclick="HandleEdit">
    <div class="work-item-header">
        <div class="work-item-title">@(string.IsNullOrWhiteSpace(WorkItem.Title) ? WorkItem.WorkerType : WorkItem.Title)</div>
        <div class="work-item-worker-type" style="color: @(WorkItem.Color ?? "#1890ff");">@WorkItem.WorkerType</div>
    </div>

    <div class="work-item-details-row">
        @if (!string.IsNullOrEmpty(AssignedFullName))
        {
            <div class="work-item-assigned">@AssignedFullName</div>
        }
        else
        {
            <div class="work-item-unassigned-label">UNASSIGNED</div>
        }
        <div class="work-item-time-inline">@CompactTime(GetDisplayTime(WorkItem.Start)) – @CompactTime(GetDisplayTime(WorkItem.End))</div>
    </div>

    @if (OvertimeHours > 0)
    {
        <div class="work-item-overtime">⚠ Overtime @FormatOvertimeHours(OvertimeHours)</div>
    }
</div>

@code {
    /// <summary>The work item to display.</summary>
    [Parameter, EditorRequired]
    public WorkItem WorkItem { get; set; } = default!;

    /// <summary>Display name of the assigned user, resolved by the parent.</summary>
    [Parameter]
    public string AssignedToDisplayName { get; set; } = string.Empty;

    /// <summary>Assigned user's first name (preferred over display name when provided).</summary>
    [Parameter]
    public string AssignedToFirstName { get; set; } = string.Empty;

    /// <summary>Assigned user's last name (preferred over display name when provided).</summary>
    [Parameter]
    public string AssignedToLastName { get; set; } = string.Empty;

    /// <summary>Callback invoked when the item is clicked for editing.</summary>
    [Parameter]
    public EventCallback<WorkItem> OnEdit { get; set; }

    /// <summary>
    /// Number of hours this work item contributes beyond the 40-hour weekly limit.
    /// When greater than zero, an overtime warning badge is shown.
    /// </summary>
    [Parameter]
    public double OvertimeHours { get; set; }

    [Parameter]
    public bool UseWallClockTime { get; set; }

    /// <summary>Full name composed from first/last name when available, otherwise falls back to display name.</summary>
    private string AssignedFullName
    {
        get
        {
            var fn = (AssignedToFirstName ?? string.Empty).Trim();
            var ln = (AssignedToLastName ?? string.Empty).Trim();
            if (!string.IsNullOrEmpty(fn) || !string.IsNullOrEmpty(ln))
                return $"{fn} {ln}".Trim();
            // If first/last are not provided, but the display name looks like a full name, use it.
            var display = (AssignedToDisplayName ?? string.Empty).Trim();
            if (!string.IsNullOrEmpty(display))
            {
                // If display contains at least one space, assume it's First Last and return it.
                if (display.Contains(' ')) return display;
                // Otherwise return display as-is (username or single name)
                return display;
            }
            return string.Empty;
        }
    }

    /// <summary>True when the work item has already ended.</summary>
    private bool IsPast => !UseWallClockTime && WorkItem.End.ToUniversalTime() < DateTime.UtcNow;

    /// <summary>
    /// True when auto-assignment used a worker's additional qualified type instead of their primary type.
    /// </summary>
    private bool IsAssignedFromAdditionalQualifiedType => WorkItem.AutoAssignedFromAdditionalQualifiedType;

    /// <summary>True when the work item is in the future and has no assigned user, visible only to managers (OnEdit delegate present).</summary>
    private bool IsUnassignedFuture =>
        !UseWallClockTime &&
        OnEdit.HasDelegate &&
        string.IsNullOrWhiteSpace(WorkItem.AssignedToUserId) &&
        WorkItem.Start.ToUniversalTime() > DateTime.UtcNow;

    private Task HandleEdit()
        => OnEdit.HasDelegate ? OnEdit.InvokeAsync(WorkItem) : Task.CompletedTask;

    private DateTime GetDisplayTime(DateTime time)
    {
        if (!UseWallClockTime && WorkItem.RotationId is null)
        {
            return time.ToLocalTime();
        }

        return time.Kind switch
        {
            DateTimeKind.Local => time.ToUniversalTime(),
            DateTimeKind.Unspecified => DateTime.SpecifyKind(time, DateTimeKind.Utc),
            _ => time
        };
    }

    /// <summary>
    /// Returns a compact time string: omits the minutes when they are zero
    /// so "7:00 AM" becomes "7 AM" and "7:30 AM" stays "7:30 AM".
    /// </summary>
    private static string CompactTime(DateTime dt)
    {
        return dt.Minute == 0
            ? dt.ToString("h tt", CultureInfo.CurrentCulture)
            : dt.ToString("h:mm tt", CultureInfo.CurrentCulture);
    }

    /// <summary>
    /// Formats the overtime hours value as a friendly string, e.g. "8 Hours" or "1.5 Hours".
    /// </summary>
    private static string FormatOvertimeHours(double hours)
    {
        // Display as a whole number when there are no fractional minutes, otherwise one decimal place.
        var rounded = Math.Round(hours, 1);
        var display = rounded == Math.Floor(rounded)
            ? ((int)rounded).ToString()
            : rounded.ToString("0.#", CultureInfo.CurrentCulture);
        return $"{display} {(rounded == 1 ? "Hour" : "Hours")}";
    }
}
