@using System.Globalization
@using Rota.Models

@* Expanded view of a single day showing its work items, absences, and reminders. *@
@{
    var isToday = State.Date == DateOnly.FromDateTime(DateTime.Today);
    var totalItems = WorkItems.Count + Absences.Count + Reminders.Count;
}

    <div class="modal-backdrop fade show"></div>
    <div class="modal fade show d-block" tabindex="-1" role="dialog">
        <div class="modal-dialog modal-dialog-centered modal-lg modal-dialog-scrollable" role="document">
            <div class="modal-content day-modal-content">

            @* Modal header *@
            <div class="modal-header day-modal-header">
                <div class="d-flex align-items-center gap-2">
                    <h5 class="modal-title mb-0 fw-bold">
                        @State.Date.ToString("dddd, MMMM d, yyyy", CultureInfo.CurrentCulture)
                        @if (isToday)
                        {
                            <span class="badge bg-primary ms-2" style="font-size:0.65rem;vertical-align:middle;">Today</span>
                        }
                    </h5>
                </div>
                <div class="d-flex align-items-center ms-auto">
                    <button type="button" class="btn-close" @onclick="OnClose" aria-label="Close"></button>
                </div>
            </div>

            @* Modal body *@
            <div class="modal-body day-detail-body">

                @* work items section *@
                @if (WorkItems.Count > 0)
                {
                    <div class="day-detail-section-header">
                        <span class="day-modal-section-icon day-modal-section-icon--work-item">🕐</span>
                        <span class="day-detail-section-title-text">Work items</span>
                        <span class="day-detail-section-count">@WorkItems.Count</span>
                    </div>
                    @foreach (var s in WorkItems)
                    {
                        var ds = s;
                        var WorkItemDuration = ds.End - ds.Start;
                        var durationText = WorkItemDuration.TotalMinutes >= 60
                            ? $"{(int)WorkItemDuration.TotalHours}h{(WorkItemDuration.Minutes > 0 ? $" {WorkItemDuration.Minutes}m" : "")}"
                            : $"{WorkItemDuration.Minutes}m";

                        <div class="day-detail-work-item-card" style="border-left-color: @(ds.Color ?? "#1890ff");"
                             @onclick="() => { if (CanManageWorkItems) OnEditWorkItem.InvokeAsync(ds); }"
                             role="@(CanManageWorkItems ? "button" : "")"
                             title="@(CanManageWorkItems ? "Click to edit" : "")">
                            <div class="day-detail-card-header day-detail-work-item-header">
                                <span class="day-detail-work-item-title">@(string.IsNullOrWhiteSpace(ds.Title) ? ds.WorkerType : ds.Title)</span>
                                <span class="day-detail-worker-badge" style="color: @(ds.Color ?? "#1890ff"); background-color: @(ds.Color ?? "#1890ff")1a;">
                                    @ds.WorkerType
                                </span>
                            </div>
                            <div class="day-detail-card-header day-detail-work-item-details">
                                @if (!string.IsNullOrWhiteSpace(ds.AssignedToUserId))
                                {
                                    <div class="day-detail-assigned"><span class="day-detail-assigned-icon">👤</span>@GetDisplayName(ds.AssignedToUserId)</div>
                                }
                                else
                                {
                                    <div class="day-detail-unassigned">UNASSIGNED</div>
                                }
                                <div class="d-flex align-items-center gap-2 ms-auto">
                                    <span class="day-detail-time-badge">@FormatWorkItemTime(ds.Start) – @FormatWorkItemTime(ds.End)</span>
                                    @if (CanManageWorkItems)
                                    {
                                        <span class="day-detail-edit-hint">Edit ›</span>
                                    }
                                </div>
                            </div>
                            @if (!string.IsNullOrEmpty(ds.Notes))
                            {
                                <div class="day-detail-item-notes">@ds.Notes</div>
                            }
                        </div>
                    }
                }

                @* Absences section *@
                @if (Absences.Count > 0)
                {
                    <div class="day-detail-section-header @(WorkItems.Count > 0 ? "mt-4" : "")">
                        <span class="day-modal-section-icon day-modal-section-icon--absence">🚇</span>
                        <span class="day-detail-section-title-text">Absences</span>
                        <span class="day-detail-section-count">@Absences.Count</span>
                    </div>
                    @foreach (var a in Absences)
                    {
                        var da = a;
                        <div class="day-detail-absence-card @(CanManageWorkItems && !da.IsApproved ? (da.ApprovalState == AbsenceApprovalState.Denied ? "day-detail-absence-card--denied" : "day-detail-absence-card--pending") : "")" style="border-left-color: @(da.Color ?? "#fa8c16"); background-color: @(da.Color ?? "#fa8c16")1a;"
                             @onclick="() => OnEditAbsence.InvokeAsync(da)" role="button" title="Click to edit">
                            <div class="day-detail-card-header">
                                <div class="d-flex flex-column flex-grow-1 min-w-0">
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="day-detail-absence-name fw-semibold text-truncate">@GetDisplayName(da.AssignedToUserId)</span>
                                        <span class="day-detail-absence-title-badge" style="background-color: @(da.Color ?? "#fa8c16")1a; color: @(da.Color ?? "#fa8c16");">@da.DisplayTitle</span>
                                        @if (CanManageWorkItems && da.ApprovalState == AbsenceApprovalState.Pending)
                                        {
                                            <span class="badge bg-warning text-dark" style="font-size:0.65rem;">⏳ Pending Approval</span>
                                        }
                                        else if (CanManageWorkItems && da.ApprovalState == AbsenceApprovalState.Denied)
                                        {
                                            <span class="badge bg-danger" style="font-size:0.65rem;">❌ Denied</span>
                                        }
                                    </div>
                                    <div class="mt-1">
                                        @{
                                            var hasTimes = !string.IsNullOrWhiteSpace(da.StartTime) && !string.IsNullOrWhiteSpace(da.EndTime) && da.DayCount == 1;
                                            if (hasTimes && TimeOnly.TryParse(da.StartTime, CultureInfo.CurrentCulture, out var ts) && TimeOnly.TryParse(da.EndTime, CultureInfo.CurrentCulture, out var te))
                                            {
                                                <span class="day-detail-time-badge">@ts.ToString("t", CultureInfo.CurrentCulture) – @te.ToString("t", CultureInfo.CurrentCulture)</span>
                                            }
                                            else
                                            {
                                                <span class="day-detail-time-badge">@(da.DayCount == 1 ? "All day" : $"{da.DayCount} days")</span>
                                            }
                                        }
                                    </div>
                                </div>
                                <span class="day-detail-edit-hint ms-2">Edit ›</span>
                            </div>
                            @if (!string.IsNullOrEmpty(da.Notes))
                            {
                                <div class="day-detail-item-notes">@da.Notes</div>
                            }
                        </div>
                    }
                }

                @* Reminders section *@
                @if (Reminders.Count > 0)
                {
                    <div class="day-detail-section-header @((WorkItems.Count > 0 || Absences.Count > 0) ? "mt-4" : "")">
                        <span class="day-modal-section-icon day-modal-section-icon--reminder">🔔</span>
                        <span class="day-detail-section-title-text">Reminders</span>
                        <span class="day-detail-section-count">@Reminders.Count</span>
                    </div>
                    @foreach (var r in Reminders)
                    {
                        var dr = r;
                        <div class="day-detail-reminder-card" style="border-left-color:@(dr.Color ?? "#ffeb3b");"
                             @onclick="() => OnEditReminder.InvokeAsync(dr)" role="button" title="Click to edit">
                            <div class="day-detail-card-header">
                                <span class="day-detail-reminder-title-text">@dr.Title</span>
                                <div class="d-flex align-items-center gap-2 ms-auto">
                                    <span class="day-detail-time-badge">@dr.ReminderDateTime.ToLocalTime().ToString("t")</span>
                                    <span class="day-detail-edit-hint">Edit ›</span>
                                </div>
                            </div>
                            @if (!string.IsNullOrEmpty(dr.Notes))
                            {
                                <div class="day-detail-item-notes">@dr.Notes</div>
                            }
                        </div>
                    }
                }

                @* Empty state *@
                @if (totalItems == 0)
                {
                    <div class="day-detail-empty">
                        <div class="day-detail-empty-icon">📅</div>
                        <div class="day-detail-empty-title">Nothing scheduled</div>
                        <div class="day-detail-empty-text">There are no work items, absences, or reminders for this day yet.</div>
                    </div>
                }
            </div>

            @* Modal footer – always-visible action buttons *@
            <div class="modal-footer day-modal-footer">
                @if (CanManageWorkItems)
                {
                    <button class="btn btn-primary btn-sm" @onclick="OnAddWorkItem">＋ Add work item</button>
                }
                <button class="btn btn-warning btn-sm text-dark" @onclick="OnAddAbsence">＋ Add Absence</button>
                <button class="btn btn-outline-secondary btn-sm" @onclick="OnAddReminder">＋ Add Reminder</button>
            </div>
        </div>
        </div>
    </div>

@code {
    /// <summary>Shared modal state (open/closed and selected date).</summary>
    [Parameter, EditorRequired] public DayModalState State { get; set; } = default!;

    /// <summary>Entries for the day, already filtered and sorted by the owner.</summary>
    [Parameter] public List<WorkItem> WorkItems { get; set; } = new();
    [Parameter] public List<Absence> Absences { get; set; } = new();
    [Parameter] public List<Reminder> Reminders { get; set; } = new();

    /// <summary>True when the user may edit work items.</summary>
    [Parameter] public bool CanManageWorkItems { get; set; }

    [Parameter, EditorRequired] public Func<string?, string> GetDisplayName { get; set; } = default!;
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<WorkItem> OnEditWorkItem { get; set; }
    [Parameter] public EventCallback<Absence> OnEditAbsence { get; set; }
    [Parameter] public EventCallback<Reminder> OnEditReminder { get; set; }
    [Parameter] public EventCallback OnAddWorkItem { get; set; }
    [Parameter] public EventCallback OnAddAbsence { get; set; }
    [Parameter] public EventCallback OnAddReminder { get; set; }

    private static string FormatWorkItemTime(DateTime time)
    {
        var localTime = time.ToLocalTime();
        return localTime.Minute == 0
            ? localTime.ToString("h tt", CultureInfo.CurrentCulture)
            : localTime.ToString("h:mm tt", CultureInfo.CurrentCulture);
    }
}
