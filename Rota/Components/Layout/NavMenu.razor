@using Microsoft.AspNetCore.Components.Authorization
@using Rota.Models
@using Rota.Components
@implements IDisposable
@inject CalendarControlsState ControlsState

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">ScheduleMeister</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="if (event.target.closest('a')) document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">
        <AuthorizeView>
            <NotAuthorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                        <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Home
                    </NavLink>
                </div>
            </NotAuthorized>
        </AuthorizeView>

        <AuthorizeView>
            <Authorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="calendar">
                        <span class="bi bi-calendar3-nav-menu" aria-hidden="true"></span> Schedules
                    </NavLink>
                </div>

                @* Calendar controls published by the Calendar page, shown beneath Schedules *@
                @if (ControlsState.Controls is not null)
                {
                    <div class="nav-controls">
                        @ControlsState.Controls
                    </div>
                }

                <AuthorizeView Roles="@Roles.ManagerOrAdmin">
                    <Authorized Context="managerContext">
                        <div class="nav-item px-3">
                            <NavLink class="nav-link" href="manage">
                                <span class="bi bi-manage-nav-menu" aria-hidden="true"></span> Manage
                            </NavLink>
                        </div>
                    </Authorized>
                </AuthorizeView>

                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="account">
                        <span class="bi bi-account-nav-menu" aria-hidden="true"></span> Settings
                    </NavLink>
                </div>
            </Authorized>
        </AuthorizeView>

        <AuthorizeView Roles="@Roles.Admin">
            <Authorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="admin">
                        <span class="bi bi-admin-nav-menu" aria-hidden="true"></span> Admin
                    </NavLink>
                </div>
            </Authorized>
        </AuthorizeView>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="faq">
                <span class="bi bi-faq-nav-menu" aria-hidden="true"></span> FAQ
            </NavLink>
        </div>

        <div class="nav-item px-3 mt-auto">
            <NavLink class="nav-link" href="about">
                <span class="bi bi-info-circle-nav-menu" aria-hidden="true"></span> About
            </NavLink>
        </div>

    </nav>
</div>

@code {
    protected override void OnInitialized() => ControlsState.Changed += OnControlsChanged;

    // State changes may originate from another component, so marshal onto the renderer's context.
    private void OnControlsChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose() => ControlsState.Changed -= OnControlsChanged;
}

