@using Rota.Models
@using System.Globalization

<div class="absence-item mb-1 @PendingClass @(IsPast ? "item--past" : "")"
     style="background-color: @(Absence.Color ?? "#fa8c16");"
     @onclick:stopPropagation="true" @onclick="HandleEdit">
    <div class="absence-top-row">
        <div class="absence-name text-start" title="@AssignedToDisplayName">@CompactAssignedName</div>
        @if (HasTimeRange)
        {
            <div class="absence-time small">
                @FormatTime(Absence.StartTime!) – @FormatTime(Absence.EndTime!)
            </div>
        }
    </div>
    <div class="absence-reason text-start text-truncate">
        <span>@Absence.DisplayTitle</span>
        @if (ShowApprovalState && Absence.ApprovalState == AbsenceApprovalState.Pending)
        {
            <span class="absence-pending-badge">⏳ Pending</span>
        }
        else if (ShowApprovalState && Absence.ApprovalState == AbsenceApprovalState.Denied)
        {
            <span class="absence-pending-badge absence-denied-badge">❌ Denied</span>
        }
    </div>
</div>

@code {
    /// <summary>The absence to display.</summary>
    [Parameter, EditorRequired]
    public Absence Absence { get; set; } = default!;

    /// <summary>Display name of the assigned user, resolved by the parent.</summary>
    [Parameter]
    public string AssignedToDisplayName { get; set; } = string.Empty;

    /// <summary>When true, pending/denied approval badges are shown.</summary>
    [Parameter]
    public bool ShowApprovalState { get; set; }

    /// <summary>Callback invoked when the item is clicked for editing.</summary>
    [Parameter]
    public EventCallback<Absence> OnEdit { get; set; }

    // Returns a modifier CSS class when the absence is not yet approved.
    // Applied regardless of ShowApprovalState so all users see the pending/denied visual style.
    private string PendingClass => !Absence.IsApproved
        ? (Absence.ApprovalState == AbsenceApprovalState.Denied
            ? "absence-item--denied"
            : "absence-item--pending")
        : string.Empty;

    /// <summary>True when the absence has already ended.</summary>
    private bool IsPast => Absence.EndDate.ToUniversalTime() < DateTime.UtcNow;

    private bool HasTimeRange => Absence.DayCount == 1 &&
        !string.IsNullOrWhiteSpace(Absence.StartTime) &&
        !string.IsNullOrWhiteSpace(Absence.EndTime) &&
        TimeOnly.TryParse(Absence.StartTime, CultureInfo.CurrentCulture, out _) &&
        TimeOnly.TryParse(Absence.EndTime, CultureInfo.CurrentCulture, out _);

    private static string FormatTime(string time) =>
        TimeOnly.Parse(time, CultureInfo.CurrentCulture).ToString("t", CultureInfo.CurrentCulture);

    private string CompactAssignedName => AssignedToDisplayName.Length > 12
        ? $"{AssignedToDisplayName[..12]}..."
        : AssignedToDisplayName;

    private Task HandleEdit()
        => OnEdit.HasDelegate ? OnEdit.InvokeAsync(Absence) : Task.CompletedTask;
}
