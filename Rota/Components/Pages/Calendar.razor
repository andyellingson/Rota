        private AbsenceReason editAbsenceReason { get => modalState.EditAbsenceReason; set => modalState.EditAbsenceReason = value; }
        private string? editAbsenceNotes { get => modalState.EditAbsenceNotes; set => modalState.EditAbsenceNotes = value; }
        private string editAbsenceColor { get => modalState.EditAbsenceColor; set => modalState.EditAbsenceColor = value; }
        private string editAbsenceForUsername { get => modalState.EditAbsenceForUsername; set => modalState.EditAbsenceForUsername = value; }
        private bool editAbsenceIsPartDay { get => modalState.EditAbsenceIsPartDay; set => modalState.EditAbsenceIsPartDay = value; }
        private TimeOnly editAbsenceStartTime { get => modalState.EditAbsenceStartTime; set => modalState.EditAbsenceStartTime = value; }
        private TimeOnly editAbsenceEndTime { get => modalState.EditAbsenceEndTime; set => modalState.EditAbsenceEndTime = value; }
        private bool newAbsenceIsApproved { get => modalState.NewAbsenceApprovalState == AbsenceApprovalState.Approved; set => modalState.NewAbsenceApprovalState = value ? AbsenceApprovalState.Approved : AbsenceApprovalState.Pending; }
        private bool editAbsenceIsApproved { get => modalState.EditAbsenceApprovalState == AbsenceApprovalState.Approved; set => modalState.EditAbsenceApprovalState = value ? AbsenceApprovalState.Approved : AbsenceApprovalState.Pending; }

        // Worker type names loaded for the current manager
        private List<string> workerTypeNames = new();

        // Preset palette: red, green, blue, orange, gray
        private readonly string[] ColorChoices = new[] { "#ff4d4f", "#52c41a", "#1890ff", "#fa8c16", "#d3d3d3" };

        /// <summary>
        /// Load reminders when the component initializes. The page-level [Authorize] attribute
        /// ensures the user is authenticated before reaching this component, so we rely on the
        /// browser's session cookie (credentials: same-origin) for API auth rather than
        /// querying HttpContextAuthenticationStateProvider, which is null during the SignalR
        /// interactive phase.
        /// </summary>
        protected override async Task OnInitializedAsync()
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;
            _username = user.Identity?.Name ?? string.Empty;

            if (!string.IsNullOrEmpty(_username))
            {
                var caller = await UserService.GetByUsernameAsync(_username);
                _userId = caller?.Id;
                _assignedScheduleIds = caller?.AssignedScheduleIds ?? new();

                canManageShifts = user.IsInRole(Roles.Manager) || user.IsInRole(Roles.Admin);
                _isManagerRole = user.IsInRole(Roles.Manager);
                if (canManageShifts)
                {
                    _managerCode = caller?.ManagerCode;
                    employees = await UserService.GetUsersByRoleAsync(Roles.Employee);
                }
                else if (user.IsInRole(Roles.Employee) && !string.IsNullOrEmpty(caller?.ManagerCode))
                {
                    // Employee documents store the manager's ManagerCode when linked
                    _managerCode = caller?.ManagerCode;
                }

                var managerCodeForLinkedUsers = caller?.ManagerCode;

                if (!string.IsNullOrEmpty(managerCodeForLinkedUsers))
                {
                    linkedUsers = await UserService.GetLinkedUsersForManagerAsync(managerCodeForLinkedUsers);
                }

                if (caller is not null && !linkedUsers.Any(u => u.Username == caller.Username))
                {
                    linkedUsers.Add(caller);
                    linkedUsers = linkedUsers
                        .OrderBy(u => u.DisplayName ?? u.Username)
                        .ThenBy(u => u.Username)
                        .ToList();
                }

                RebuildUserCache();
                newReminderForUsername = _username;
                newAbsenceForUsername = _userId;

                // Load schedules for all roles
                if (!string.IsNullOrEmpty(_userId))
                {
                    await LoadSchedules();

                    // Load worker types for the resolved manager
                    if (canManageShifts)
                    {
                        var workerTypes = await WorkerTypesService.GetByOwnerAsync(_userId);
                        workerTypeNames = workerTypes.Select(w => w.Name).ToList();
                    }
                }

            }

            await LoadReminders();
        }

        /// <summary>
        /// Load available schedules.
        /// Managers see all schedules they own; employees see only schedules they
        /// have at least one shift assigned to them on.
        /// </summary>
        private async Task LoadSchedules()
        {
            if (string.IsNullOrEmpty(_userId))
            {
                return;
            }

            try
            {
                if (canManageShifts)
                {
                    availableSchedules = await SchedulesService.GetSchedulesForManagerAsync(_userId, _managerCode);

                    // Ensure at least one schedule exists for managers
                    if (availableSchedules.Count == 0 && !string.IsNullOrEmpty(_username))
                    {
                        var defaultSchedule = await SchedulesService.GetOrCreateDefaultScheduleAsync(_userId, _username, _managerCode);
                        availableSchedules.Add(defaultSchedule);
                    }
                }
                else
                {
                    // Employees: only the schedules their manager has assigned to them
                    if (_assignedScheduleIds.Count > 0)
                    {
                        availableSchedules = await SchedulesService.GetSchedulesByIdsAsync(_assignedScheduleIds);
                    }
                }

                // Set initial schedule selection
                if (!string.IsNullOrEmpty(QueryScheduleId))
                {
                    selectedScheduleId = QueryScheduleId;
                }
                else
                {
                    var defaultSchedule = availableSchedules.FirstOrDefault(s => s.IsDefault) ?? availableSchedules.FirstOrDefault();
                    selectedScheduleId = defaultSchedule?.Id;
                }
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Error loading schedules");
            }
        }

        /// <summary>
        /// Called when the selected schedule changes
        /// </summary>
