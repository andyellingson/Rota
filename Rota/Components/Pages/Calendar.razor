        /// <summary>
        /// Returns the total number of shifts (after filters) across all selected days.
        /// </summary>
        private int GetTotalShiftsInSelectedDays()
        {
            return selectedDays.Sum(d => GetShiftsForDay(d).Count);
        }

        /// <summary>
        /// Returns the total number of absences across all selected days.
        /// </summary>
        private int GetTotalAbsencesInSelectedDays()
        {
            return selectedDays
                .SelectMany(d => GetAbsencesForDay(d))
                .Select(a => a.Id)
                .Where(id => id is not null)
                .Distinct()
                .Count();
        }

        /// <summary>
        /// Returns the total number of reminders across all selected days.
        /// </summary>
        private int GetTotalRemindersInSelectedDays()
        {
            return selectedDays
                .SelectMany(d => GetRemindersForDay(d))
                .Select(r => r.Id)
                .Where(id => id is not null)
                .Distinct()
                .Count();
        }

        /// <summary>
        /// Returns the total number of unassigned shifts (after filters) across all selected days.
        /// </summary>
        private int GetTotalUnassignedShiftsInSelectedDays()
        {
            // Count unassigned shifts using the loaded `shifts` collection rather than
            // `GetShiftsForDay` so the button enables even if UI filters temporarily hide
            // unassigned shifts. Match schedule filter and local-day overlap similarly.
            if (shifts == null || shifts.Count == 0) return 0;

            var ids = new HashSet<string?>(StringComparer.OrdinalIgnoreCase);
            foreach (var s in shifts)
            {
                if (!string.IsNullOrEmpty(s.AssignedToUserId)) continue;
                if (!string.IsNullOrEmpty(selectedScheduleId) && s.ScheduleId != selectedScheduleId) continue;
                var day = DateOnly.FromDateTime(s.Start.ToLocalTime());
                if (selectedDays.Contains(day)) ids.Add(s.Id);
            }

            return ids.Count(id => id is not null);
        }

