        /// <summary>
        /// Loads Shifts for the specified inclusive query range (expects UTC-normalized yyyy-MM-dd values).
        /// </summary>
        private async Task LoadShifts(DateOnly queryStart, DateOnly queryEnd)
        {
            try
            {
                shifts = await ShiftService.GetShiftsAsync(_username, _userId, _managerCode, queryStart, queryEnd);
                Logger.LogInformation("Loaded {Count} Shifts", shifts.Count);

                // Determine which worker types are present in the loaded shifts and
                // initialise the visibility map. Preserve existing visibility choices
                // when possible; default new types to visible.
                var types = shifts
                    .Select(s => string.IsNullOrWhiteSpace(s.WorkerType) ? "General" : s.WorkerType)
                    .Distinct(StringComparer.OrdinalIgnoreCase)
                    .OrderBy(t => t)
                    .ToList();

                var newMap = new Dictionary<string, bool>(StringComparer.OrdinalIgnoreCase);
                foreach (var t in types)
                {
                    if (workerTypeVisibility.TryGetValue(t, out var val))
                        newMap[t] = val;
                    else
                        newMap[t] = true;
                }
                workerTypeVisibility = newMap;

                // Rebuild employee visibility map from distinct AssignedToUserId values in loaded shifts.
                // Preserve existing visibility choices; default new employees to visible.
                var empKeys = shifts
                    .Select(s => string.IsNullOrWhiteSpace(s.AssignedToUserId) ? "__unassigned__" : s.AssignedToUserId)
                    .Distinct(StringComparer.OrdinalIgnoreCase)
                    .ToList();

                var newEmpMap = new Dictionary<string, bool>(StringComparer.OrdinalIgnoreCase);
                foreach (var empKey in empKeys)
                {
                    if (employeeVisibility.TryGetValue(empKey, out var val))
                        newEmpMap[empKey] = val;
                    else
                        newEmpMap[empKey] = true;
                }
                employeeVisibility = newEmpMap;
                RebuildShiftDayBucket();
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Error loading shifts");
                shifts = new List<Shift>();
            }
        }

