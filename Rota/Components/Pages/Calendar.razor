            editAbsenceReason = absence.Reason;
            editAbsenceNotes = absence.Notes;
            editAbsenceColor = absence.Color ?? "#fa8c16";
            // AssignedToUserId stores the user _id for the absent person
            editAbsenceForUsername = absence.AssignedToUserId ?? GetLinkedUser(_userId)?.Id ?? _userId;
            // Populate part-day fields from explicit StartTime/EndTime when available
            if (!string.IsNullOrWhiteSpace(absence.StartTime) && !string.IsNullOrWhiteSpace(absence.EndTime) && absence.DayCount == 1)
            {
                editAbsenceIsPartDay = true;
                if (TimeOnly.TryParse(absence.StartTime, CultureInfo.CurrentCulture, out var st))
                    editAbsenceStartTime = st;
                if (TimeOnly.TryParse(absence.EndTime, CultureInfo.CurrentCulture, out var et))
                    editAbsenceEndTime = et;
            }
            else
            {
                editAbsenceIsPartDay = false;
                editAbsenceStartTime = new(9, 0);
                editAbsenceEndTime = new(17, 0);
            }
            editAbsenceIsApproved = absence.IsApproved;
            modalState.EditAbsenceApprovalState = absence.ApprovalState;
            modalError = null;
            modalMode = ModalMode.Absence;
            showModal = true;
        }

