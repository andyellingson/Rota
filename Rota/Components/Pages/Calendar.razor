        // Rebuilds the date -> shifts lookup used by the calendar views.
        private void RebuildShiftDayBucket()
        {
            var newMap = new Dictionary<DateOnly, List<Shift>>();
            foreach (var shift in shifts)
            {
                var startDay = DateOnly.FromDateTime(shift.Start.ToLocalTime());
                var endDay = DateOnly.FromDateTime(shift.End.AddTicks(-1).ToLocalTime());
                for (var day = startDay; day <= endDay; day = day.AddDays(1))
                {
                    if (!newMap.TryGetValue(day, out var dayShifts))
                        newMap[day] = dayShifts = new List<Shift>();
                    dayShifts.Add(shift);
                }
            }
            _shiftsByDay = newMap;
        }

        // Rebuilds the date -> absences lookup.
        private void RebuildAbsenceDayBucket()
        {
            var newMap = new Dictionary<DateOnly, List<Absence>>();
            foreach (var absence in absences)
            {
                var startDay = DateOnly.FromDateTime(absence.StartDate.ToLocalTime());
                var endDay = DateOnly.FromDateTime(absence.EndDate.AddTicks(-1).ToLocalTime());
                for (var day = startDay; day <= endDay; day = day.AddDays(1))
                {
                    if (!newMap.TryGetValue(day, out var dayAbsences))
                        newMap[day] = dayAbsences = new List<Absence>();
                    dayAbsences.Add(absence);
                }
            }
            _absencesByDay = newMap;
        }

        // Rebuilds the date -> reminders lookup.
        private void RebuildReminderDayBucket()
        {
            var newMap = new Dictionary<DateOnly, List<Reminder>>();
            foreach (var reminder in reminders)
            {
                var day = DateOnly.FromDateTime(reminder.ReminderDateTime.ToLocalTime());
                if (!newMap.TryGetValue(day, out var dayReminders))
                    newMap[day] = dayReminders = new List<Reminder>();
                dayReminders.Add(reminder);
            }
            _remindersByDay = newMap;
        }

        // Rebuilds the user id -> user lookup.
        private void RebuildUserCache()
        {
            var newMap = new Dictionary<string, User>(StringComparer.OrdinalIgnoreCase);
            foreach (var user in linkedUsers)
                if (user.Id is not null) newMap.TryAdd(user.Id, user);
            foreach (var user in employees)
                if (user.Id is not null) newMap.TryAdd(user.Id, user);
            _userById = newMap;
        }
