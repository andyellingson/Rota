        private Dictionary<string, bool> employeeVisibility = new();

        // Pre-bucketed day lookups built after each data load to avoid O(n × 42) full-list scans per render.
        private Dictionary<DateOnly, List<Shift>> _shiftsByDay = new();
        private Dictionary<DateOnly, List<Absence>> _absencesByDay = new();
        private Dictionary<DateOnly, List<Reminder>> _remindersByDay = new();
        // O(1) user-id lookup rebuilt whenever employees or linkedUsers change.
        private Dictionary<string, User> _userById = new();

        // Modal state
        private readonly CalendarEditModalState modalState = new();
        private bool showModal { get => modalState.ShowModal; set => modalState.ShowModal = value; }
        private DateOnly? selectedDate { get => modalState.SelectedDate; set => modalState.SelectedDate = value; }
        private ModalMode modalMode { get => modalState.ModalMode; set => modalState.ModalMode = value; }
        private string newReminderTitle { get => modalState.NewReminderTitle; set => modalState.NewReminderTitle = value; }
        private string? newReminderNotes { get => modalState.NewReminderNotes; set => modalState.NewReminderNotes = value; }
        private TimeOnly newReminderTime { get => modalState.NewReminderTime; set => modalState.NewReminderTime = value; }
        private string newReminderColor { get => modalState.NewReminderColor; set => modalState.NewReminderColor = value; }
        private string newReminderForUsername { get => modalState.NewReminderForUsername; set => modalState.NewReminderForUsername = value; }
        private string? modalError { get => modalState.ModalError; set => modalState.ModalError = value; }
        private bool isBusy { get => modalState.IsBusy; set => modalState.IsBusy = value; }

        // Print modal state
        private bool showPrintModal = false;

        // Multi-day selection state
        private SelectionMode selectionMode = SelectionMode.Off;
        private bool isMultiSelectMode => selectionMode != SelectionMode.Off;
        private HashSet<DateOnly> selectedDays = new();
        private bool showMultiDayConfirmModal = false;
        private bool isBulkDeleting = false;
        private string? multiDayActionError = null;
        private BulkDeleteType bulkDeleteType = BulkDeleteType.Shifts;

        // Day detail modal and auto-populate state
        private readonly DayModalState dayModal = new();
        private bool showDayModal { get => dayModal.IsOpen; set => dayModal.IsOpen = value; }
        private DateOnly dayModalDate { get => dayModal.Date; set => dayModal.Date = value; }
        private string? dayModalSelectedWorkWeekId { get => dayModal.SelectedRotationId; set => dayModal.SelectedRotationId = value; }
        private string? dayModalWorkWeekError { get => dayModal.RotationError; set => dayModal.RotationError = value; }
        private bool dayModalIsApplying { get => dayModal.IsApplying; set => dayModal.IsApplying = value; }
        private DateOnly workWeekRangeStart { get => dayModal.RotationRangeStart; set => dayModal.RotationRangeStart = value; }
        private DateOnly workWeekRangeEnd { get => dayModal.RotationRangeEnd; set => dayModal.RotationRangeEnd = value; }
        private DateOnly autoPopulateRangeStart { get => dayModal.AutoRangeStart; set => dayModal.AutoRangeStart = value; }
        private DateOnly autoPopulateRangeEnd { get => dayModal.AutoRangeEnd; set => dayModal.AutoRangeEnd = value; }
        private string? autoPopulateError { get => dayModal.AutoError; set => dayModal.AutoError = value; }
        private string? autoPopulateWarning { get => dayModal.AutoWarning; set => dayModal.AutoWarning = value; }
        private string? autoPopulateSuccess { get => dayModal.AutoSuccess; set => dayModal.AutoSuccess = value; }
        private bool autoPopulateIsRunning { get => dayModal.AutoIsRunning; set => dayModal.AutoIsRunning = value; }

        // Multi-day template / auto-assign state
        private string? multiDaySelectedWorkWeekId;
        private string? multiDayWorkWeekError;
        private bool multiDayIsApplying = false;

        private bool multiDayAutoIsRunning = false;
        private string? multiDayAutoError;
        private string? multiDayAutoWarning;
        private string? multiDayAutoSuccess;

