                absences = await AbsenceService.GetAbsencesAsync(_managerCode, _userId, queryStart, queryEnd);
                RebuildAbsenceDayBucket();
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Error loading absences");
                absences = new();
            }
        }

        private string GetEmployeeDisplayNameById(string? userId)
        {
            if (string.IsNullOrEmpty(userId)) return string.Empty;
            // O(1) lookup via pre-built dictionary instead of sequential list scan.
            if (_userById.TryGetValue(userId, out var emp))
                return emp.DisplayName ?? emp.Username ?? userId;
            return userId;
        }

        private string GetEmployeeFirstNameById(string? userId)
        {
            if (string.IsNullOrEmpty(userId)) return string.Empty;
            // O(1) lookup via pre-built dictionary; fall back to username scan for legacy records.
            if (_userById.TryGetValue(userId, out var emp)) return emp.FirstName ?? string.Empty;
            var fallback = employees.FirstOrDefault(e => e.Username == userId)
                           ?? linkedUsers.FirstOrDefault(u => u.Username == userId);
            return fallback?.FirstName ?? string.Empty;
        }

        private string GetEmployeeLastNameById(string? userId)
        {
            if (string.IsNullOrEmpty(userId)) return string.Empty;
            // O(1) lookup via pre-built dictionary; fall back to username scan for legacy records.
            if (_userById.TryGetValue(userId, out var emp)) return emp.LastName ?? string.Empty;
            var fallback = employees.FirstOrDefault(e => e.Username == userId)
                           ?? linkedUsers.FirstOrDefault(u => u.Username == userId);
            return fallback?.LastName ?? string.Empty;
        }

        private User? GetLinkedUser(string? username)
        {
            if (string.IsNullOrWhiteSpace(username)) return null;
            return linkedUsers.FirstOrDefault(u => u.Username == username);
        }

        private User? GetLinkedUserById(string? id)
        {
            if (string.IsNullOrWhiteSpace(id)) return null;
            return linkedUsers.FirstOrDefault(u => u.Id == id);
        }

        private User? GetDefaultLinkedUser()
        {
            return GetLinkedUser(_username) ?? linkedUsers.FirstOrDefault();
        }

        private string GetShiftDisplayTitle(Shift shift)
