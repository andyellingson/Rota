@page "/calendar"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using System.Globalization
@using Rota.Models
@using Rota.Services
@using Rota.Components
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject NavigationManager Navigation
@inject Microsoft.Extensions.Logging.ILogger<Calendar> Logger
@inject IRemindersService RemindersService
@inject IShiftsService ShiftService
@inject IAbsencesService AbsenceService
@inject IUserService UserService
@inject ISchedulesService SchedulesService
@inject Microsoft.AspNetCore.Components.Authorization.AuthenticationStateProvider AuthStateProvider
@inject IWorkerTypesService WorkerTypesService
@inject IJSRuntime JS
@inject IRotationTemplateService RotationTemplateService
@inject IShiftAutoAssignService AutoAssignService

<div class="schedule-page">
    <CalendarToolbar Schedules="availableSchedules"
                     @bind-SelectedScheduleId="selectedScheduleId" @bind-SelectedScheduleId:after="OnScheduleChanged"
                     @bind-ShowShifts="showShifts" @bind-ShowShifts:after="FilterChanged"
                     @bind-ShowAbsences="showAbsences" @bind-ShowAbsences:after="FilterChanged"
                     @bind-ShowReminders="showReminders" @bind-ShowReminders:after="FilterChanged"
                     WorkerTypeVisibility="workerTypeVisibility"
                     EmployeeVisibility="employeeVisibility"
                     GetEmployeeFilterName="GetEmployeeDisplayNameForFilter"
                     OnFilterChanged="FilterChanged"
                     View="view" OnViewChanged="SetView"
                     OnPrev="Prev" OnNext="Next" OnPrint="OpenPrintModal"
                     SelectionMode="selectionMode" OnSelectionModeChanged="SetSelectionMode" />

    @* ── Multi-day inline action bar ────────────────────────────────── *@
    @if (isMultiSelectMode && selectedDays.Count > 0)
    {
        var totalShifts = GetTotalShiftsInSelectedDays();
        var totalAbsences = GetTotalAbsencesInSelectedDays();
        var totalReminders = GetTotalRemindersInSelectedDays();
        var totalUnassignedShifts = GetTotalUnassignedShiftsInSelectedDays();
        <div class="multi-day-action-bar">
            @* ── Row 1: buttons ──────────────────────────────────────── *@
            <div class="multi-day-action-bar-row">
                <span class="action-bar-info">
                    @selectedDays.Count day@(selectedDays.Count == 1 ? "" : "s") selected
                </span>
                <span class="action-bar-sep" aria-hidden="true"></span>
                @if (canManageShifts)
                {
                    var wwSelMulti = availableSchedules.FirstOrDefault(s => s.Id == selectedScheduleId);
                    if (wwSelMulti?.Rotations?.Count > 0)
                    {
                        <select class="form-select form-select-sm d-inline-block" style="width:auto;min-width:220px;" @bind="multiDaySelectedWorkWeekId">
                            <option value="">— Select Rotation Template —</option>
                            @foreach (var ww in wwSelMulti.Rotations)
                            {
                                <option value="@ww.Id">@ww.Name</option>
                            }
                        </select>
                        <button class="btn btn-sm btn-primary ms-2" @onclick="ApplyWorkWeekToSelectedDays" disabled="@(string.IsNullOrEmpty(multiDaySelectedWorkWeekId) || multiDayIsApplying)">
                            @if (multiDayIsApplying)
                            {
                                <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                                <span>Applying…</span>
                            }
                            else
                            {
                                <span>Apply Template</span>
                            }
                        </button>
                    }

                    <button class="btn btn-sm btn-success ms-2" @onclick="AutoPopulateSelectedDays" disabled="@(multiDayAutoIsRunning || totalUnassignedShifts == 0)">
                        @if (multiDayAutoIsRunning)
                        {
                            <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                            <span>Assigning…</span>
                        }
                        else
                        {
                            <span>Auto Assign</span>
                        }
                    </button>
                }
                @if (canManageShifts && totalShifts > 0)
                {
                    <button class="btn btn-sm btn-danger ms-2" @onclick="@(() => OpenMultiDayDeleteModal(BulkDeleteType.Shifts))"
                            title="Delete all shifts within the selected days">
                        🗑 Delete @totalShifts Shift@(totalShifts == 1 ? "" : "s")
                    </button>
                }
                @if (totalAbsences > 0)
                {
                    <button class="btn btn-sm btn-warning text-dark ms-2" @onclick="@(() => OpenMultiDayDeleteModal(BulkDeleteType.Absences))"
                            title="Delete all absences within the selected days">
                        🗑 Delete @totalAbsences Absence@(totalAbsences == 1 ? "" : "s")
                    </button>
                }
                @if (totalReminders > 0)
                {
                    <button class="btn btn-sm btn-info text-dark ms-2" @onclick="@(() => OpenMultiDayDeleteModal(BulkDeleteType.Reminders))"
                            title="Delete all reminders within the selected days">
                        🗑 Delete @totalReminders Reminder@(totalReminders == 1 ? "" : "s")
                    </button>
                }
                <span class="action-bar-sep" aria-hidden="true"></span>
                <button class="btn btn-sm btn-outline-secondary" @onclick="ClearDaySelection"
                        title="Deselect all days">
                    Clear Selection
                </button>
            </div>

            @* ── Row 2: feedback messages ─────────────────────────────── *@
            @if (!string.IsNullOrEmpty(multiDayWorkWeekError) ||
                 !string.IsNullOrEmpty(multiDayAutoError) ||
                 !string.IsNullOrEmpty(multiDayAutoWarning) ||
                 !string.IsNullOrEmpty(multiDayAutoSuccess))
            {
                <div class="multi-day-action-bar-messages">
                    @if (!string.IsNullOrEmpty(multiDayWorkWeekError))
                    {
                        <span class="text-danger small">@multiDayWorkWeekError</span>
                    }
                    @if (!string.IsNullOrEmpty(multiDayAutoError))
                    {
                        <span class="text-danger small">@multiDayAutoError</span>
                    }
                    @if (!string.IsNullOrEmpty(multiDayAutoWarning))
                    {
                        <span class="text-warning small">@multiDayAutoWarning</span>
                    }
                    @if (!string.IsNullOrEmpty(multiDayAutoSuccess))
                    {
                        <span class="text-success small">@multiDayAutoSuccess</span>
                    }
                </div>
            }
        </div>
    }

    @* ── Calendar views (replaced with component) ─────────────────────────── *@
    <div class="calendar-card card shadow-sm mt-2 mb-4">
        <div class="card-body">
            @if (view == ViewMode.Month)
            {
                <CalendarMonthView Current="current" SelectedDays="selectedDays" OnDayClick="HandleDayClick">
                    <DayContent Context="day">
                        <CalendarDayItems Items="GetSortedDayItems(day)"
                                          CanManageShifts="canManageShifts"
                                          GetDisplayName="GetEmployeeDisplayNameById"
                                          GetFirstName="GetEmployeeFirstNameById"
                                          GetLastName="GetEmployeeLastNameById"
                                          GetOvertimeHours="GetShiftOvertimeHours"
                                          OnEditShift="OpenEditShiftModal"
                                          OnEditAbsence="OpenEditAbsenceModal"
                                          OnEditReminder="OpenEditReminderModal" />
                    </DayContent>
                </CalendarMonthView>
            }
            else
            {
                <CalendarWeekView Current="current" SelectedDays="selectedDays" OnDayClick="HandleDayClick" OnAddClick="OpenAddReminderModal">
                    <DayContent Context="day">
                        <CalendarDayItems Items="GetSortedDayItems(day)"
                                          CanManageShifts="canManageShifts"
                                          GetDisplayName="GetEmployeeDisplayNameById"
                                          GetFirstName="GetEmployeeFirstNameById"
                                          GetLastName="GetEmployeeLastNameById"
                                          GetOvertimeHours="GetShiftOvertimeHours"
                                          OnEditShift="OpenEditShiftModal"
                                          OnEditAbsence="OpenEditAbsenceModal"
                                          OnEditReminder="OpenEditReminderModal" />
                    </DayContent>
                </CalendarWeekView>
            }
        </div>
    </div>

    @* ── Day detail modal – expanded view for a single day *@
    @if (showDayModal)
    {
        var detailShifts = GetShiftsForDay(dayModalDate).OrderBy(s => s.Start).ToList();
        var detailReminders = GetRemindersForDay(dayModalDate).OrderBy(r => r.ReminderDateTime).ToList();
        var detailAbsences = GetAbsencesForDay(dayModalDate).OrderBy(a => a.StartDate).ToList();
        var scheduleRotations = availableSchedules.FirstOrDefault(s => s.Id == selectedScheduleId)?.Rotations;

        <DayDetailsModal State="dayModal"
                         Shifts="detailShifts" Absences="detailAbsences" Reminders="detailReminders"
                         CanManageShifts="canManageShifts" Rotations="scheduleRotations"
                         GetDisplayName="GetEmployeeDisplayNameById"
                         OnClose="CloseDayModal" OnApplyTemplate="ApplyWorkWeekForDay" OnAutoPopulate="AutoPopulateShifts"
                         OnEditShift="OpenEditShiftModal" OnEditAbsence="OpenEditAbsenceModal" OnEditReminder="OpenEditReminderModal"
                         OnAddShift="AddShiftFromDayModal" OnAddAbsence="AddAbsenceFromDayModal" OnAddReminder="AddReminderFromDayModal" />
    }

    @* ── Multi-day bulk-delete confirmation modal ─────────────────────── *@
    @if (showMultiDayConfirmModal)
    {
        var confirmCount = bulkDeleteType switch
        {
            BulkDeleteType.Absences => GetTotalAbsencesInSelectedDays(),
            BulkDeleteType.Reminders => GetTotalRemindersInSelectedDays(),
            _ => GetTotalShiftsInSelectedDays()
        };

        <BulkDeleteConfirmModal Type="bulkDeleteType" Count="confirmCount" DayCount="selectedDays.Count"
                                IsDeleting="isBulkDeleting" Error="@multiDayActionError"
                                OnClose="CloseMultiDayConfirmModal" OnConfirm="ExecuteBulkDelete" />
    }

    <PrintScheduleModal OnClose="@(() => showPrintModal = false)"
                        ViewMode="@(view == ViewMode.Month ? PrintScheduleModal.PrintViewMode.Month : PrintScheduleModal.PrintViewMode.Week)"
                        CurrentDate="current"
                        ScheduleName="@(availableSchedules.FirstOrDefault(s => s.Id == selectedScheduleId)?.Name ?? "Schedule")"
                        ShiftsForDay="GetShiftsForDay"
                        AbsencesForDay="GetAbsencesForDay"
                        RemindersForDay="GetRemindersForDay"
                        GetEmployeeDisplayName="GetEmployeeDisplayNameById"
                        GetEmployeeFirstName="GetEmployeeFirstNameById"
                        GetEmployeeLastName="GetEmployeeLastNameById"
                        GetShiftTitle="GetShiftDisplayTitle"
                        LoadRangeData="LoadDataForDateRange" />

    <CalendarEditModal State="modalState"
                       CanManageShifts="canManageShifts"
                       CanEditAbsence="@CanModifyAbsence(editingAbsence)"
                       Employees="employees"
                       LinkedUsers="linkedUsers"
                       ColorChoices="ColorChoices"
                       WorkerTypes="workerTypeNames"
                       OnClose="CloseModal"
                       OnSaveReminder="SaveReminder"
                       OnUpdateReminder="UpdateReminder"
                       OnDeleteReminder="DeleteCurrentReminder"
                       OnSaveShift="SaveShift"
                       OnUpdateShift="UpdateShift"
                       OnDeleteShift="DeleteCurrentShift"
                       OnDeleteShiftSeries="DeleteShiftSeries"
                       OnSaveAbsence="SaveAbsence"
                       OnUpdateAbsence="UpdateAbsence"
                       OnDeleteAbsence="DeleteCurrentAbsence" />

</div>

    @code {
        private ViewMode view = ViewMode.Month;

        // Current user context resolved at initialization
        private string _username = string.Empty;

        // True only for the manager role (not admin); only managers get roster-wide absence edit/delete rights.
        private bool _isManagerRole;

        /// <summary>
        /// Returns true when the current user created the absence or is the manager linked to its roster.
        /// A null absence (new entry) is always editable.
        /// </summary>
        private bool CanModifyAbsence(Absence? absence)
        {
            if (absence is null) return true;
            // Managers linked to the roster can always modify
            if (_isManagerRole
                && !string.IsNullOrEmpty(_managerCode)
                && absence.ManagerCode == _managerCode) return true;
            // The requesting employee can only modify until a manager has approved the absence
            return !string.IsNullOrEmpty(absence.Username)
                && absence.Username == _username
                && absence.ApprovalState != AbsenceApprovalState.Approved;
        }

        // Manager scope passed to the absence service; employees never receive roster-wide rights.
        private string? AbsenceManagerScope => _isManagerRole ? _managerCode : null;
        private string? _managerCode;

        // Schedule IDs the employee's manager has assigned to the current user
        private List<string> _assignedScheduleIds = new();
        private string? _userId;

        // Current date used for rendering the calendar context (month or week)
        private DateOnly current = DateOnly.FromDateTime(DateTime.Today);

        // Loaded reminders for the current view
        private List<Reminder> reminders = new List<Reminder>();
        // Loaded Shifts for the current view
        private List<Shift> shifts = new List<Shift>();
        // Loaded Absences for the current view
        private List<Absence> absences = new();
        private bool isLoading = false;

        // Shift assignment / role state
        private List<User> employees = new();
        private List<User> linkedUsers = new();
        private bool canManageShifts = false;

        // Schedule selection state
        private List<Schedule> availableSchedules = new();
        private string? selectedScheduleId;
        [SupplyParameterFromQuery(Name = "scheduleId")]
        private string? QueryScheduleId { get; set; }

        // Event type filters
        private bool showShifts = true;
        private bool showAbsences = true;
        private bool showReminders = true;

        // Worker type visibility for filtering calendar shifts. Keys are worker type names and
        // values indicate whether that type should be shown. This map is populated from the
