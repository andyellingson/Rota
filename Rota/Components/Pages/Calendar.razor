        /// <summary>
        /// Sets the active selection mode. Clicking the already-active mode exits selection;
        /// switching between modes clears the current selection.
        /// </summary>
        private void SetSelectionMode(SelectionMode mode)
        {
            if (selectionMode == mode)
            {
                // Clicking the active button again exits selection mode
                selectionMode = SelectionMode.Off;
                selectedDays.Clear();
                showMultiDayConfirmModal = false;
            }
            else
            {
                // Switching modes clears any existing selection
                selectedDays.Clear();
                showMultiDayConfirmModal = false;
                selectionMode = mode;
            }
        }

        /// <summary>
        /// Toggles the selection of a day or the entire week containing it,
        /// depending on the active selection mode.
        /// </summary>
        private void ToggleDaySelection(DateOnly day)
        {
            if (selectionMode == SelectionMode.Week)
            {
                var weekDays = GetWeekDays(day).ToList();
                // If every day in the week is already selected, deselect them all; otherwise select all
                if (weekDays.All(d => selectedDays.Contains(d)))
                    foreach (var d in weekDays) selectedDays.Remove(d);
                else
                    foreach (var d in weekDays) selectedDays.Add(d);
            }
            else
            {
                if (!selectedDays.Add(day))
                    selectedDays.Remove(day);
            }
        }

        /// <summary>
        /// Returns the 7 days of the week that contains the given date, respecting the
        /// current culture's first day of week.
        /// </summary>
        private IEnumerable<DateOnly> GetWeekDays(DateOnly day)
        {
            var weekStart = CalendarDates.StartOfWeek(day);
            return Enumerable.Range(0, 7).Select(i => weekStart.AddDays(i));
        }

