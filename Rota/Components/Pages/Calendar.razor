        /// <summary>
        /// Applies the selected WorkWeek template across the user-defined date range.
        /// Iterates every day from workWeekRangeStart through workWeekRangeEnd and creates a
        /// shift for each day whose DayOfWeek matches a template entry – naturally handling
        /// partial weeks at either end of the range.
        /// </summary>
        private async Task ApplyWorkWeekForDay()
        {
            dayModalWorkWeekError = null;
            if (string.IsNullOrEmpty(dayModalSelectedWorkWeekId))
            {
                dayModalWorkWeekError = "Please select a WorkWeek template.";
                return;
            }
            if (string.IsNullOrEmpty(selectedScheduleId))
            {
                dayModalWorkWeekError = "No schedule is selected.";
                return;
            }

            if (string.IsNullOrEmpty(_managerCode))
            {
                dayModalWorkWeekError = "Your account does not have a manager code. Please contact support.";
                return;
            }

            if (workWeekRangeEnd < workWeekRangeStart)
            {
                dayModalWorkWeekError = "End date must be on or after the start date.";
                return;
            }

            try
            {
                dayModalIsApplying = true;

                var result = await RotationTemplateService.ApplyAsync(dayModalSelectedWorkWeekId, _username, _managerCode, selectedScheduleId, Enumerable.Range(0, (workWeekRangeEnd.DayNumber - workWeekRangeStart.DayNumber) + 1).Select(d => workWeekRangeStart.AddDays(d)).ToArray());

                dayModalWorkWeekError = result.Error;
                if (dayModalWorkWeekError != null) return;

                await LoadReminders();
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Error applying WorkWeek template over date range {Start} – {End}", workWeekRangeStart, workWeekRangeEnd);
                dayModalWorkWeekError = "An error occurred while applying the WorkWeek template. Please try again.";
            }
            finally
            {
                dayModalIsApplying = false;
            }
        }

        private async Task ApplyWorkWeekToSelectedDays()
        {
            multiDayWorkWeekError = null;
            if (selectedDays.Count == 0)
            {
                multiDayWorkWeekError = "No days are selected.";
                return;
            }
            if (string.IsNullOrEmpty(multiDaySelectedWorkWeekId))
            {
                multiDayWorkWeekError = "Please select a WorkWeek template.";
                return;
            }
            if (string.IsNullOrEmpty(selectedScheduleId))
            {
                multiDayWorkWeekError = "No schedule is selected.";
                return;
            }
            if (string.IsNullOrEmpty(_managerCode))
            {
                multiDayWorkWeekError = "Your account does not have a manager code. Please contact support.";
                return;
            }

            try
            {
                multiDayIsApplying = true;
                var result = await RotationTemplateService.ApplyAsync(multiDaySelectedWorkWeekId, _username,
                    _managerCode, selectedScheduleId, selectedDays.OrderBy(day => day));
                if (result.Error is not null)
                {
                    multiDayWorkWeekError = result.Error;
                    return;
                }
                await LoadReminders();
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Error applying WorkWeek template to selected days");
                multiDayWorkWeekError = "An error occurred while applying the template. Please try again.";
            }
            finally
            {
                multiDayIsApplying = false;
            }
        }

