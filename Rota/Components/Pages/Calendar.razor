        /// <summary>
        /// Load reminders and Shifts for the current view range from the server.
        /// </summary>
        private async Task LoadReminders()
        {
            isLoading = true;
            await InvokeAsync(StateHasChanged);

            try
            {
                // Calculate date range based on view
                DateOnly start, end;
                if (view == ViewMode.Month)
                {
                    var firstOfMonth = new DateOnly(current.Year, current.Month, 1);
                    start = CalendarDates.StartOfWeek(firstOfMonth);
                    var lastOfMonth = firstOfMonth.AddMonths(1).AddDays(-1);
                    end = CalendarDates.StartOfWeek(lastOfMonth).AddDays(6 * 7);
                }
                else
                {
                    start = CalendarDates.StartOfWeek(current);
                    end = start.AddDays(6);
                }

                // Query a slightly broader range to avoid missing items due to UTC/local day boundaries.
                var queryStart = start.AddDays(-1);
                var queryEnd = end.AddDays(1);

                reminders = await RemindersService.GetCalendarRemindersAsync(_managerCode, _userId, queryStart, queryEnd);
                RebuildReminderDayBucket();
                await LoadShifts(queryStart, queryEnd);
                await LoadAbsences(queryStart, queryEnd);
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Error loading calendar data");
                reminders = new List<Reminder>();
                shifts = new List<Shift>();
                absences = new();
            }
            finally
            {
                isLoading = false;
                await InvokeAsync(StateHasChanged);
            }
        }

        /// <summary>
        /// Gets reminders for a specific day.
        /// </summary>
        private List<Reminder> GetRemindersForDay(DateOnly day)
        {
            if (!showReminders) return new List<Reminder>();

            // Use pre-bucketed lookup — O(k) where k is reminders on this day, not O(n) over all reminders.
            if (!_remindersByDay.TryGetValue(day, out var dayReminders) || dayReminders.Count == 0)
                return new List<Reminder>();

            // Filter by schedule when one is selected; return the bucket directly when no filter applies.
            if (string.IsNullOrEmpty(selectedScheduleId))
                return dayReminders;

            return dayReminders
                .Where(r => r.ScheduleId == selectedScheduleId)
                .ToList();
        }

