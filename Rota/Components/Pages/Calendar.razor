        /// <summary>
        /// Gets Shifts that intersect the specified day.
        /// </summary>
        private List<Shift> GetShiftsForDay(DateOnly day)
        {
            if (!showShifts) return new List<Shift>();

            // Use pre-bucketed lookup — O(k) where k is shifts on this day, not O(n) over all shifts.
            if (!_shiftsByDay.TryGetValue(day, out var dayShifts) || dayShifts.Count == 0)
                return new List<Shift>();

            return dayShifts
                .Where(s => string.IsNullOrEmpty(selectedScheduleId) || s.ScheduleId == selectedScheduleId)
                .Where(s =>
                {
                    // If no worker-type filters are present, allow all shifts. Use a fallback name for null/empty types.
                    if (workerTypeVisibility == null || workerTypeVisibility.Count == 0) return true;
                    var wt = string.IsNullOrWhiteSpace(s.WorkerType) ? "General" : s.WorkerType;
                    return workerTypeVisibility.TryGetValue(wt, out var visible) && visible;
                })
                .Where(s =>
                {
                    // If no employee filters are present, allow all shifts.
                    if (employeeVisibility == null || employeeVisibility.Count == 0) return true;
                    var empKey = string.IsNullOrWhiteSpace(s.AssignedToUserId) ? "__unassigned__" : s.AssignedToUserId;
                    return employeeVisibility.TryGetValue(empKey, out var visible) && visible;
                })
                .ToList();
        }

        /// <summary>
        /// Returns the number of hours this shift contributes beyond the 40-hour weekly (Sun–Sat) limit
        /// for the assigned user. Returns 0 when no overtime is applicable.
        /// </summary>
        private double GetShiftOvertimeHours(Shift shift)
        {
            if (string.IsNullOrEmpty(shift.AssignedToUserId)) return 0;

            // Determine the Sunday that starts the week containing this shift (UTC).
            var shiftStartUtc = shift.Start.ToUniversalTime().Date;
            int daysFromSunday = (int)shiftStartUtc.DayOfWeek; // DayOfWeek.Sunday == 0
            var weekStart = shiftStartUtc.AddDays(-daysFromSunday);
            var weekEnd = weekStart.AddDays(7);

            // Collect all assigned shifts for this user in the same week, ordered by start time.
            var weekShifts = shifts
                .Where(s => s.AssignedToUserId == shift.AssignedToUserId
                         && s.Start.ToUniversalTime() >= weekStart
                         && s.Start.ToUniversalTime() < weekEnd)
                .OrderBy(s => s.Start)
                .ToList();

            // Walk through shifts in order, accumulating hours, and find how many hours
            // of the target shift fall beyond the 40-hour weekly limit.
            const double weeklyLimit = 40.0;
            double cumulative = 0;

            foreach (var s in weekShifts)
            {
                double shiftHours = (s.End - s.Start).TotalHours;
                double hoursAfterThisShift = cumulative + shiftHours;

                if (s.Id == shift.Id)
                {
                    // Return only the portion of this shift that is overtime.
                    if (hoursAfterThisShift > weeklyLimit)
                        return Math.Round(hoursAfterThisShift - Math.Max(cumulative, weeklyLimit), 1);
                    return 0;
                }

                cumulative = hoursAfterThisShift;
            }

            return 0;
        }

        private List<Absence> GetAbsencesForDay(DateOnly day)
        {
            if (!showAbsences) return new List<Absence>();

            // Use pre-bucketed lookup — O(k) where k is absences on this day, not O(n) over all absences.
            // Absences are person-level records and are not filtered by schedule;
            // every absence in the date range is shown regardless of which schedule is selected.
            return _absencesByDay.TryGetValue(day, out var dayAbsences) ? dayAbsences : new List<Absence>();
        }

        /// <summary>
        /// Returns the display name for an employee key used in the filter dropdown.
        /// The special key "__unassigned__" maps to a human-readable label.
        /// </summary>
        private string GetEmployeeDisplayNameForFilter(string empKey)
        {
            if (empKey == "__unassigned__") return "(Unassigned)";

            var firstName = GetEmployeeFirstNameById(empKey);
            var lastName = GetEmployeeLastNameById(empKey);
            var fullName = string.Join(" ", new[] { firstName, lastName }.Where(n => !string.IsNullOrWhiteSpace(n)));

            return !string.IsNullOrWhiteSpace(fullName)
                ? fullName
                : GetEmployeeDisplayNameById(empKey);
        }

