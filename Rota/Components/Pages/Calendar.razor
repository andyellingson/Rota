        private List<CalendarDayItem> GetSortedDayItems(DateOnly day)
        {
            var dayShifts = GetShiftsForDay(day);
            var dayAbsences = GetAbsencesForDay(day);
            var dayReminders = GetRemindersForDay(day);
            // Pre-size to avoid mid-loop re-allocations.
            var items = new List<CalendarDayItem>(dayShifts.Count + dayAbsences.Count + dayReminders.Count);

            foreach (var s in dayShifts)
                items.Add(new CalendarDayItem(s.Start, Shift: s));

            foreach (var a in dayAbsences)
            {
                var sortKey = a.StartDate;
                if (a.DayCount == 1 && !string.IsNullOrWhiteSpace(a.StartTime) &&
                    TimeOnly.TryParse(a.StartTime, CultureInfo.CurrentCulture, out var t))
                {
                    sortKey = day.ToDateTime(t, DateTimeKind.Local).ToUniversalTime();
                }
                items.Add(new CalendarDayItem(sortKey, Absence: a));
            }

            foreach (var r in dayReminders)
                items.Add(new CalendarDayItem(r.ReminderDateTime, Reminder: r));

            return [.. items.OrderBy(i => i.SortKey)];
        }

