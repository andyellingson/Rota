        /// <summary>
        /// Dispatches to the correct bulk-delete method based on the active BulkDeleteType.
        /// </summary>
        private async Task ExecuteBulkDelete()
        {
            switch (bulkDeleteType)
            {
                case BulkDeleteType.Absences:
                    await DeleteAllAbsencesInSelectedDays();
                    break;
                case BulkDeleteType.Reminders:
                    await DeleteAllRemindersInSelectedDays();
                    break;
                default:
                    await DeleteAllShiftsInSelectedDays();
                    break;
            }
        }

        /// <summary>
        /// Deletes all visible shifts across the currently selected days and reloads the calendar.
        /// </summary>
        private async Task DeleteAllShiftsInSelectedDays()
        {
            isBulkDeleting = true;
            multiDayActionError = null;

            try
            {
                // Collect distinct shift IDs across all selected days respecting active filters
                var shiftIds = selectedDays
                    .SelectMany(d => GetShiftsForDay(d))
                    .Select(s => s.Id)
                    .Where(id => id is not null)
                    .Distinct()
                    .ToList();

                foreach (var id in shiftIds)
                {
                    await ShiftService.DeleteShiftAsync(id!, _username);
                }

                showMultiDayConfirmModal = false;
                selectedDays.Clear();
                await LoadReminders();
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Error bulk-deleting shifts for selected days");
                multiDayActionError = "An error occurred while deleting shifts. Please try again.";
            }
            finally
            {
                isBulkDeleting = false;
            }
        }

        /// <summary>
        /// Deletes all absences across the currently selected days and reloads the calendar.
        /// </summary>
        private async Task DeleteAllAbsencesInSelectedDays()
        {
            isBulkDeleting = true;
            multiDayActionError = null;

            try
            {
                var absencesToDelete = selectedDays
                    .SelectMany(d => GetAbsencesForDay(d))
                    .Where(a => a.Id is not null)
                    .GroupBy(a => a.Id)
                    .Select(g => g.First())
                    .ToList();

                foreach (var absence in absencesToDelete)
                {
                    var deleted = await AbsenceService.DeleteAbsenceAsync(absence.Id!, _username, AbsenceManagerScope);
                    if (!deleted)
                    {
                        multiDayActionError = "One or more absences could not be deleted. They may already be approved or outside your permissions.";
                        await LoadReminders();
                        return;
                    }
                }

                showMultiDayConfirmModal = false;
                selectedDays.Clear();
                await LoadReminders();
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Error bulk-deleting absences for selected days");
                multiDayActionError = "An error occurred while deleting absences. Please try again.";
            }
            finally
            {
                isBulkDeleting = false;
            }
        }

        /// <summary>
        /// Deletes all reminders across the currently selected days and reloads the calendar.
        /// </summary>
        private async Task DeleteAllRemindersInSelectedDays()
        {
            isBulkDeleting = true;
            multiDayActionError = null;

            try
            {
                // Collect distinct reminder objects so we can pass each one's own Username to the
                // delete call — the service filters by both id AND username, so using _username
                // would silently skip reminders whose Username differs from the current user.
                var remindersToDelete = selectedDays
                    .SelectMany(d => GetRemindersForDay(d))
                    .Where(r => r.Id is not null)
                    .GroupBy(r => r.Id)
                    .Select(g => g.First())
                    .ToList();

                foreach (var reminder in remindersToDelete)
                {
                    await RemindersService.DeleteReminderAsync(reminder.Id!, reminder.Username ?? _username);
                }

                showMultiDayConfirmModal = false;
                selectedDays.Clear();
                await LoadReminders();
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Error bulk-deleting reminders for selected days");
                multiDayActionError = "An error occurred while deleting reminders. Please try again.";
            }
            finally
            {
                isBulkDeleting = false;
            }
        }

