@page "/manage"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using Rota.Models
@using System.Globalization
@using Rota.Services
@using Rota.Components
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "manager,admin")]
@inject ISchedulesService SchedulesService
@inject IWorkItemsService WorkItemsService
@inject IUserService UserService
@inject Microsoft.AspNetCore.Components.Authorization.AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation
@inject Microsoft.Extensions.Logging.ILogger<Manage> Logger
@inject IAbsencesService AbsencesService
@inject IWorkerTypesService WorkerTypesService
@inject IRotationsService RotationsService
@inject IJSRuntime JS

<div class="container my-4">
    <div class="card shadow-sm">
        <div class="card-body">
            <div class="d-flex align-items-center mb-4">
                <div class="me-auto">
                    <h4 class="mb-0">Manage Schedules</h4>
                    <small class="manage-subtitle">Create and manage your work schedules</small>
                </div>
                <button class="btn btn-primary" @onclick="OpenCreateModal">
                    <span class="me-1">+</span> New Schedule
                </button>
            </div>

            @if (!string.IsNullOrEmpty(rotationListError))
            {
                <div class="alert alert-danger" role="alert">@rotationListError</div>
            }

            @if (isLoading)
            {
                <div class="text-center py-5">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                </div>
            }
            else if (schedules.Count == 0)
            {
                <div class="alert alert-info">
                    <strong>No schedules yet.</strong> Create your first schedule to get started.
                </div>
            }
            else
            {
                <div class="schedule-list">
                    @foreach (var schedule in schedules)
                    {
                        <div class="schedule-card @(schedule.IsDefault ? "schedule-card-default" : "")">
                            <div class="schedule-card-body">
                                <div class="schedule-card-title">
                                    @schedule.Name
                                    @if (schedule.IsDefault)
                                    {
                                        <span class="badge bg-primary ms-2">Default</span>
                                    }
                                </div>
                                @if (!string.IsNullOrEmpty(schedule.Description))
                                {
                                    <div class="schedule-card-desc">@schedule.Description</div>
                                }
                                <div class="schedule-card-meta">Created @schedule.CreatedAt.ToLocalTime().ToString("g")</div>
                            </div>
                            <div class="schedule-card-actions">
                                @if (!schedule.IsDefault)
                                {
                                    <button class="btn btn-sm btn-outline-primary" @onclick="(() => SetAsDefault(schedule))">
                                        Set Default
                                    </button>
                                }
                                <button class="btn btn-sm btn-outline-secondary" @onclick="(() => ViewInCalendar(schedule))">
                                    Calendar
                                </button>
                                <button class="btn btn-sm btn-outline-warning" @onclick="(() => OpenEditModal(schedule))">
                                    Edit
                                </button>
                                @if (schedules.Count > 1)
                                {
                                    <button class="btn btn-sm btn-outline-danger" @onclick="(() => OpenDeleteConfirm(schedule))">
                                        Delete
                                    </button>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>

    <div class="card shadow-sm mt-3">
        <div class="card-body">
            <div class="d-flex align-items-center mb-3">
                <div class="me-auto">
                    <h4 class="mb-0">Rotations</h4>
                    <small class="manage-subtitle">Create reusable templates and choose which schedules can use them</small>
                </div>
                <button class="btn btn-primary" @onclick="OpenCreateRotation" disabled="@(schedules.Count == 0)">
                    <span class="me-1">+</span> New Rotation
                </button>
            </div>

            @if (isLoading)
            {
                <div class="text-center py-3">
                    <div class="spinner-border spinner-border-sm text-primary" role="status">
                        <span class="visually-hidden">Loading rotations...</span>
                    </div>
                </div>
            }
            else if (rotations.Count == 0)
            {
                <div class="alert alert-info mb-0">No rotations yet. Create a rotation to use it on one or more schedules.</div>
            }
            else
            {
                <div class="schedule-list">
                    @foreach (var rotation in rotations)
                    {
                        <div class="schedule-card">
                            <div class="schedule-card-body">
                                <div class="schedule-card-title">@rotation.Name</div>
                                <div class="schedule-card-desc">Available on @rotation.ScheduleIds.Count schedule(s)</div>
                                <div class="schedule-card-meta">@(rotationWorkItemCounts.GetValueOrDefault(rotation.Id ?? string.Empty, 0)) template WorkItem(s)</div>
                            </div>
                            <div class="schedule-card-actions">
                                <button class="btn btn-sm btn-outline-warning" @onclick="(() => OpenEditRotation(rotation))">Edit</button>
                                <button class="btn btn-sm btn-outline-danger" @onclick="(() => DeleteRotationFromList(rotation))" disabled="@isBusy">Delete</button>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>

@* Rotation edit modal *@
@if (showRotationModal)
{
    <div class="modal-backdrop fade show"></div>
    <div class="modal fade show d-block" tabindex="-1" role="dialog">
        <div class="modal-dialog modal-dialog-centered ww-modal-dialog modal-dialog-scrollable" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@(editingRotation == null ? "Create New Rotation" : "Edit Rotation")</h5>
                    <button type="button" class="btn-close" @onclick="CloseRotationModal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    @if (showCreateRotation)
                    {
                        @if (!string.IsNullOrEmpty(rotationModalState.ModalError))
                        {
                            <div class="alert alert-danger" role="alert">@rotationModalState.ModalError</div>
                        }

                        <div class="mb-3">
                            <label class="form-label fw-semibold">Rotation Name</label>
                            <input class="form-control" @bind="newRotationName" @bind:after="OnRotationChanged" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold">Available Schedules</label>
                            <div class="rotation-schedule-options">
                                @foreach (var schedule in schedules)
                                {
                                    <label class="form-check rotation-schedule-option" for="rotation-schedule-@schedule.Id">
                                        <input class="form-check-input" type="checkbox" id="rotation-schedule-@schedule.Id"
                                               checked="@selectedRotationScheduleIds.Contains(schedule.Id ?? string.Empty)"
                                               @onchange="(e => ToggleRotationSchedule(schedule.Id, e.Value is bool selected && selected))" />
                                        <span class="form-check-label">@schedule.Name</span>
                                    </label>
                                }
                            </div>
                            @if (selectedRotationScheduleIds.Count == 0)
                            {
                                <div class="text-danger small mt-1">Select at least one schedule.</div>
                            }
                        </div>

                        <div class="mb-2">
                            <strong>Work items</strong>
                            <div class="text-muted small">Click a day to open its work item list. Click an existing work item to edit it.</div>
                        </div>

                        @* Week view for adding work items to weekdays *@
                        <div class="week-grid mb-3">
                            @{
                                var today = DateOnly.FromDateTime(DateTime.Today);
                                var firstDay = CultureInfo.CurrentCulture.DateTimeFormat.FirstDayOfWeek;
                                var diff = ((int)today.DayOfWeek - (int)firstDay + 7) % 7;
                                var start = today.AddDays(-diff);
                            }
                            @foreach (var d in Enumerable.Range(0, 7).Select(i => start.AddDays(i)))
                            {
                                var dow = d.DayOfWeek;
                                <div class="week-day-card card p-2" @onclick="(() => OpenRotationDayModal(dow))">
                                    <div class="d-flex justify-content-between align-items-start mb-2">
                                        <div class="fw-bold">@d.ToString("dddd")</div>
                                    </div>
                                    <div class="events">
                                        @foreach (var s in newRotationWorkItems.Where(s => s.WorkDay == dow).OrderBy(s => s.Start))
                                        {
                                            <WorkItemCard WorkItem="s"
                                                       UseWallClockTime="true"
                                                       AssignedToDisplayName="@(employees.FirstOrDefault(e => e.Id == s.AssignedToUserId)?.DisplayName ?? employees.FirstOrDefault(e => e.Id == s.AssignedToUserId)?.Username ?? string.Empty)"
                                                       AssignedToFirstName="@(employees.FirstOrDefault(e => e.Id == s.AssignedToUserId)?.FirstName ?? string.Empty)"
                                                       AssignedToLastName="@(employees.FirstOrDefault(e => e.Id == s.AssignedToUserId)?.LastName ?? string.Empty)"
                                                       OnEdit="@(EventCallback.Factory.Create<WorkItem>(this, EditRotationWorkItem))" />
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>

                @* Footer: Delete on the left, Cancel + Save on the right *@
                <div class="modal-footer">
                    <div class="me-auto">
                        @if (editingRotation != null)
                        {
                            <button class="btn btn-outline-danger" @onclick="DeleteCurrentRotation" disabled="@isBusy">
                                Delete Rotation
                            </button>
                        }
                    </div>
                    <button class="btn btn-secondary" @onclick="CancelCreateRotation" disabled="@isBusy">Cancel</button>
                    <button class="btn btn-primary" @onclick="SaveRotation" disabled="@(!hasRotationChanges || isBusy)">
                        @(isBusy ? "Saving…" : "Save Rotation")
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@* Create/Edit Schedule Modal *@
@if (showModal)
{
    <div class="modal-backdrop fade show"></div>
    <div class="modal fade show d-block" tabindex="-1" role="dialog">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@(editingSchedule == null ? "Create New Schedule" : "Edit Schedule")</h5>
                    <button type="button" class="btn-close" @onclick="CloseModal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    @if (!string.IsNullOrEmpty(modalError))
                    {
                        <div class="alert alert-danger">@modalError</div>
                    }

                    <div class="mb-3">
                        <label class="form-label">Schedule Name <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" @bind="scheduleName" placeholder="e.g. April 2026 Schedule" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Description (optional)</label>
                        <textarea class="form-control" rows="3" @bind="scheduleDescription" placeholder="Add a description for this schedule"></textarea>
                    </div>

                    @if (editingSchedule == null || !editingSchedule.IsDefault)
                    {
                        <div class="mb-3 form-check">
                            <input class="form-check-input" type="checkbox" id="setAsDefault" @bind="setAsDefault" />
                            <label class="form-check-label" for="setAsDefault">
                                Set as default schedule
                            </label>
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CloseModal" disabled="@isBusy">Cancel</button>
                    <button type="button" class="btn btn-primary" @onclick="SaveSchedule" disabled="@isBusy">
                        @(isBusy ? "Saving..." : "Save")
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@* Delete Confirmation Modal *@
@if (showDeleteConfirm && scheduleToDelete != null)
{
    <div class="modal-backdrop fade show"></div>
    <div class="modal fade show d-block" tabindex="-1" role="dialog">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content">
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title">Delete Schedule</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CloseDeleteConfirm" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    @if (!string.IsNullOrEmpty(modalError))
                    {
                        <div class="alert alert-danger">@modalError</div>
                    }
                    <p>Are you sure you want to delete the schedule <strong>@scheduleToDelete.Name</strong>?</p>
                    <p class="text-danger mb-0">
                        <strong>Warning:</strong> All WorkItems, absences, and reminders associated with this schedule will be permanently deleted.
                    </p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CloseDeleteConfirm" disabled="@isBusy">Cancel</button>
                    <button type="button" class="btn btn-danger" @onclick="DeleteSchedule" disabled="@isBusy">
                        @(isBusy ? "Deleting..." : "Delete Schedule")
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@if (showDeleteRotationConfirm && rotationToDelete != null)
{
    <div class="modal-backdrop fade show"></div>
    <div class="modal fade show d-block" tabindex="-1" role="dialog">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content">
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title">Delete Rotation</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CloseDeleteRotationConfirm" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    @if (!string.IsNullOrEmpty(rotationListError))
                    {
                        <div class="alert alert-danger">@rotationListError</div>
                    }
                    <p>Are you sure you want to delete the rotation <strong>@rotationToDelete.Name</strong>?</p>
                    <p class="text-danger mb-0"><strong>Warning:</strong> All template WorkItems associated with this rotation will be permanently deleted.</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CloseDeleteRotationConfirm" disabled="@isBusy">Cancel</button>
                    <button type="button" class="btn btn-danger" @onclick="ConfirmDeleteRotation" disabled="@isBusy">
                        @(isBusy ? "Deleting..." : "Delete Rotation")
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@if (showUnlinkConfirm && selectedMember is not null)
{
    <div class="modal-backdrop fade show"></div>
    <div class="modal fade show d-block" tabindex="-1" role="dialog">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content">
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title">Unlink Employee</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CloseUnlinkConfirm" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p class="mb-2">Are you sure you want to unlink <strong>@GetMemberFullName(selectedMember)</strong> from your team?</p>
                    <p class="text-danger mb-0"><strong>Warning:</strong> The employee will lose access to your team schedules until they are linked again.</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CloseUnlinkConfirm" disabled="@isBusy">Cancel</button>
                    <button type="button" class="btn btn-danger" @onclick="ConfirmUnlinkSelectedMember" disabled="@isBusy">
                        @(isBusy ? "Unlinking..." : "Unlink Employee")
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@* Combined Manage Team card: Team Code, Team Member Types, Team Members all nested in one card *@
<div class="container my-4">
    <div class="card shadow-sm">
        <div class="card-body">
            <h4 class="mb-0">Manage Team</h4>
            <small class="manage-subtitle">Team code, roles and members for managing your team.</small>

            <hr class="my-3" />

            @* Team Code (nested card) *@
            <div class="card mb-3">
                <div class="card-body p-3">
                    <h6 class="mb-1">🏷️ Team Code</h6>
                    <p class="manage-subtitle small mb-2">Share this code with any team members you'd like to invite to the team..</p>
                    <div class="d-flex gap-2 align-items-center">
                        <input class="form-control manager-code-input" value="@(_managerCode ?? string.Empty)" readonly onclick="this.select()" />
                        <button class="btn btn-outline-secondary text-nowrap" @onclick="() => CopyManagerCode()" disabled="@codeCopied">@(codeCopied ? "Copied!" : "Copy")</button>
                    </div>
                </div>
            </div>

            <hr class="my-3" />

            @* Team Member Types (nested card) *@
            <div class="card mb-3">
                <div class="card-body p-3">
                    <h6 class="mb-1">🏷️ Team Member Types</h6>
                    <p class="manage-subtitle small mb-2">Define the types of team members.</p>

                    @if (workerTypes.Count == 0)
                    {
                        <div class="alert alert-info mb-3">No team member types defined yet. Add one below.</div>
                    }
                    else
                    {
                        <div class="d-flex flex-wrap gap-2 mb-3">
                            @foreach (var wt in workerTypes)
                            {
                                <span class="badge bg-secondary d-flex align-items-center gap-1 fs-6 px-3 py-2">
                                    @wt.Name
                                    <button type="button" class="btn-close btn-close-white ms-1" style="font-size: 0.6rem;" aria-label="Remove @wt.Name" @onclick="(() => RemoveWorkerType(wt))" disabled="@isBusy"></button>
                                </span>
                            }
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(workerTypeError))
                    {
                        <div class="alert alert-danger py-2">@workerTypeError</div>
                    }

                    <div class="d-flex gap-2">
                        <input class="form-control form-control-sm" style="max-width: 240px;" placeholder="New team member type name" @bind="newWorkerTypeName" @bind:event="oninput" @onkeydown="OnWorkerTypeKeyDown" />
                        <button class="btn btn-sm btn-primary" @onclick="AddWorkerType" disabled="@(isBusy || string.IsNullOrWhiteSpace(newWorkerTypeName))">Add</button>
                    </div>
                </div>
            </div>

            <hr class="my-3" />

            @* Team Members (nested card) *@
            <div class="card mb-0">
                <div class="card-body p-3">
                    <h6 class="mb-1">👥 Team Members</h6>
                    <p class="manage-subtitle small mb-2">Team members currently linked to your team.</p>

                    @if (linkedUsers.Count == 0)
                    {
                        <div class="alert alert-info mb-0">No employees are linked to your team yet. Share your team code above.</div>
                    }
                    else
                    {
                        <div class="team-master-detail">
                            <div class="team-member-list">
                                @foreach (var member in linkedUsers)
                                {
                                    <button class="team-member-list-item @(selectedMember?.Username == member.Username ? "active" : "")" @onclick="() => SelectMember(member)">
                                        <span class="team-list-name">@GetMemberFullName(member)</span>
                                        <span class="team-list-team-member-type">@member.TeamMemberType</span>
                                    </button>
                                }
                            </div>

                            <div class="team-detail-panel">
                                @if (selectedMember is null)
                                {
                                    <div class="team-detail-empty">Select a team member to view their details.</div>
                                }
                                else
                                {
                                    <div class="team-detail-header">
                                        <div>
                                            <div class="team-detail-name">@GetMemberFullName(selectedMember)</div>
                                            <div class="team-detail-username text-muted small">@selectedMember.Username</div>
                                        </div>
                                        <button class="btn btn-sm btn-outline-danger"
                                                @onclick="PromptUnlinkSelectedMember"
                                                disabled="@isBusy"
                                                title="Unlink this employee from your team">
                                            Unlink Employee
                                        </button>
                                    </div>
                                    @if (!string.IsNullOrEmpty(memberUnlinkMessage))
                                    {
                                        <div class="team-detail-message @(memberUnlinkError ? "team-detail-message-error" : "team-detail-message-ok") mt-2">@memberUnlinkMessage</div>
                                    }

                                    <div class="team-detail-info-grid mt-3">
                                        <div class="team-detail-field" style="grid-row: 1; grid-column: 1;">
                                            <label class="team-detail-label">Team Member Type</label>
                                            <div class="d-flex gap-2 align-items-center mt-1">
                                                <select class="form-select form-select-sm" style="min-width:220px;" @bind="selectedMemberTeamMemberType">
                                                    @foreach (var wt in workerTypes)
                                                    {
                                                        <option value="@wt.Name">@wt.Name</option>
                                                    }
                                                    @if (!string.IsNullOrEmpty(selectedMemberTeamMemberType) && !workerTypes.Any(w => w.Name == selectedMemberTeamMemberType))
                                                    {
                                                        <option value="@selectedMemberTeamMemberType">@selectedMemberTeamMemberType (removed)</option>
                                                    }
                                                </select>

                                                <button class="btn btn-sm btn-primary" @onclick="SaveTeamMemberTypeOnly" disabled="@(!HasTeamMemberTypeChanged || isBusy)">Save</button>

                                                @if (!string.IsNullOrEmpty(memberTeamMemberTypeMessage))
                                                {
                                                    <div class="team-detail-message @(memberTeamMemberTypeError ? "team-detail-message-error" : "team-detail-message-ok") ms-3">@memberTeamMemberTypeMessage</div>
                                                }
                                            </div>
                                        </div>

                                        <div class="team-detail-field" style="grid-row: 1; grid-column: 2;">
                                            <label class="team-detail-label small mb-1">Max hours / week</label>
                                            <div class="d-flex gap-2 mt-1">
                                                <input type="number" step="0.5" min="0" class="form-control form-control-sm" style="width:120px;" @bind="selectedMemberMaxHours" />
                                                <button class="btn btn-sm btn-primary" @onclick="SaveMaxHoursOnly" disabled="@(!HasMaxHoursChanged || isBusy)">Save</button>
                                            </div>
                                            @if (!string.IsNullOrEmpty(selectedMemberMaxHoursMessage))
                                            {
                                                <div class="team-detail-message @(selectedMemberMaxHoursError ? "team-detail-message-error" : "team-detail-message-ok") mt-2">@selectedMemberMaxHoursMessage</div>
                                            }
                                        </div>

                                        <div class="team-detail-field" style="grid-row: 1; grid-column: 3;">
                                            <label class="team-detail-label small mb-1">Work item Priority</label>
                                            <div class="d-flex gap-2 mt-1 align-items-center">
                                                <input type="number" step="1" min="0" class="form-control form-control-sm" style="width:100px;" @bind="selectedMemberPriority"
                                                       title="Higher number = assigned WorkItems first. Employees with equal priority share WorkItems in round-robin order." />
                                                <button class="btn btn-sm btn-primary" @onclick="SavePriorityOnly" disabled="@(!HasPriorityChanged || isBusy)">Save</button>
                                            </div>
                                            @if (!string.IsNullOrEmpty(selectedMemberPriorityMessage))
                                            {
                                                <div class="team-detail-message @(selectedMemberPriorityError ? "team-detail-message-error" : "team-detail-message-ok") mt-2">@selectedMemberPriorityMessage</div>
                                            }
                                            <div class="text-muted small mt-1">Higher = assigned first. Equal priority = round-robin.</div>
                                        </div>

                                        <div class="team-detail-field" style="grid-row: 3; grid-column: 1 / span 3;">
                                            <label class="team-detail-label">Assigned Schedules</label>
                                            @if (schedules.Count == 0)
                                            {
                                                <div class="team-member-no-avail mt-1">No schedules available.</div>
                                            }
                                            else
                                            {
                                                <div class="mt-1">
                                                    @foreach (var sch in schedules)
                                                    {
                                                        var schId = sch.Id!;
                                                        <div class="form-check">
                                                            <input class="form-check-input" type="checkbox" id="assign-@schId"
                                                                   checked="@selectedMemberScheduleIds.Contains(schId)"
                                                                   @onchange="e => ToggleMemberSchedule(schId, (bool)(e.Value ?? false))" />
                                                            <label class="form-check-label" for="assign-@schId">@sch.Name</label>
                                                        </div>
                                                    }
                                                </div>
                                                <button class="btn btn-sm btn-primary mt-2" @onclick="SaveAssignedSchedules" disabled="@(!HasScheduleAssignmentChanged || isBusy)">Save</button>
                                                @if (!string.IsNullOrEmpty(memberScheduleMessage))
                                                {
                                                    <div class="team-detail-message @(memberScheduleError ? "team-detail-message-error" : "team-detail-message-ok") mt-2">@memberScheduleMessage</div>
                                                }
                                            }
                                        </div>

                                        <div class="team-detail-field" style="grid-row: 2; grid-column: 1;">
                                            <label class="team-detail-label">Weekly Availability</label>
                                            @if (selectedMember.Availability.Count == 0)
                                            {
                                                <div class="team-member-no-avail mt-1">No availability set.</div>
                                            }
                                            else
                                            {
                                                <div class="team-member-avail mt-1">
                                                    @foreach (var day in Enum.GetValues<DayOfWeek>())
                                                    {
                                                        var windows = selectedMember.Availability.Where(a => a.DayOfWeek == day).OrderBy(a => a.StartTime).ToList();
                                                        @if (windows.Count > 0)
                                                        {
                                                            <div class="team-avail-row">
                                                                <span class="team-avail-day">@day.ToString()[..3]</span>
                                                                <span class="team-avail-times">@string.Join(", ", windows.Select(w => $"{FormatTime(w.StartTime)}–{FormatTime(w.EndTime)}"))</span>
                                                            </div>
                                                        }
                                                    }
                                                </div>
                                            }
                                        </div>

                                        <div class="team-detail-field" style="grid-row: 2; grid-column: 2;">
                                            <label class="team-detail-label">Upcoming Absences</label>
                                            @{ var memberKey = selectedMember.Id ?? selectedMember.Username ?? string.Empty; upcomingAbsences.TryGetValue(memberKey, out var memberAbsences); }
                                            @if (memberAbsences == null || memberAbsences.Count == 0)
                                            {
                                                <div class="team-member-no-avail mt-1">No upcoming absences.</div>
                                            }
                                            else
                                            {
                                                <div class="list-group mt-1">
                                                    @foreach (var a in memberAbsences)
                                                    {
                                                        <div class="list-group-item list-group-item-action d-flex justify-content-between align-items-start" style="cursor: pointer;" @onclick="(() => OpenEditAbsenceModal(a))" title="Click to edit absence">
                                                            <div>
                                                                <div class="fw-bold">@a.DisplayTitle</div>
                                                                <div class="team-absence-date small">@a.StartDate.ToLocalTime().ToString("d") – @a.EndDate.AddDays(-1).ToLocalTime().ToString("d")</div>
                                                                @if (!string.IsNullOrEmpty(a.Notes)) { <div class="team-absence-notes small">@a.Notes</div> }
                                                            </div>
                                                            <div class="text-end ms-3 flex-shrink-0">
                                                                @if (a.IsApproved) { <span class="badge bg-success">Approved</span> }
                                                                else if (a.ApprovalState == AbsenceApprovalState.Denied) { <span class="badge bg-danger">Denied</span> }
                                                                else { <span class="badge bg-secondary">Pending</span> }
                                                            </div>
                                                        </div>
                                                    }
                                                </div>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>

        </div>
    </div>
</div>

@* Rotation day work item list modal *@
