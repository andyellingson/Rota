        absenceModalState.EditAbsenceStartDateUtc = absence.StartDate.ToString("O");
        absenceModalState.EditAbsenceDayCount = absence.DayCount;
        absenceModalState.EditAbsenceReason = absence.Reason;
        absenceModalState.EditAbsenceNotes = absence.Notes;
        absenceModalState.EditAbsenceColor = absence.Color ?? "#fa8c16";
        // Use the user id stored on the absence to pre-select the correct user
        absenceModalState.EditAbsenceForUsername = absence.AssignedToUserId ?? absence.UserId ?? string.Empty;
        absenceModalState.EditAbsenceApprovalState = absence.ApprovalState;

        // Populate part-day fields
        if (!string.IsNullOrWhiteSpace(absence.StartTime) && !string.IsNullOrWhiteSpace(absence.EndTime) && absence.DayCount == 1)
        {
            absenceModalState.EditAbsenceIsPartDay = true;
            if (TimeOnly.TryParse(absence.StartTime, System.Globalization.CultureInfo.CurrentCulture, out var st))
                absenceModalState.EditAbsenceStartTime = st;
            if (TimeOnly.TryParse(absence.EndTime, System.Globalization.CultureInfo.CurrentCulture, out var et))
                absenceModalState.EditAbsenceEndTime = et;
        }
        else
        {
            absenceModalState.EditAbsenceIsPartDay = false;
            absenceModalState.EditAbsenceStartTime = new(9, 0);
            absenceModalState.EditAbsenceEndTime = new(17, 0);
        }

        absenceModalState.ModalError = null;
        absenceModalState.ModalMode = ModalMode.Absence;
        absenceModalState.ShowModal = true;
    }

