    /// <summary>
    /// Converts a stored "HH:mm" 24-hour string to a 12-hour AM/PM display string (e.g. "9:00 AM").
    /// Returns the original string unchanged if it cannot be parsed.
    /// </summary>
    private static string FormatTime(string time) =>
        TimeOnly.TryParse(time, out var t) ? t.ToString("h:mm tt") : time;

