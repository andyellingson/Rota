    /// <summary>
    /// Unlinks the selected employee from this manager and removes them from the team list.
    /// </summary>
    private async Task ConfirmUnlinkSelectedMember()
    {
        if (selectedMember is null || string.IsNullOrEmpty(_managerCode)) return;

        showUnlinkConfirm = false;
        memberUnlinkMessage = null;
        isBusy = true;
        try
        {
            var removedUsername = selectedMember.Username;
            var ok = await UserService.UnlinkFromManagerAsync(removedUsername, _managerCode);
            if (!ok)
            {
                memberUnlinkMessage = "Could not unlink employee. Please try again.";
                memberUnlinkError = true;
                return;
            }

            await RefreshLinkedUsersAsync();

            // Move selection to the next available member, or clear when list is empty.
            var fallback = linkedUsers.FirstOrDefault(u => u.Username != removedUsername) ?? linkedUsers.FirstOrDefault();
            if (fallback is null)
            {
                selectedMember = null;
            }
            else
            {
                await SelectMember(fallback);
            }

            memberUnlinkMessage = "Employee unlinked.";
            memberUnlinkError = false;
        }
        finally
        {
            isBusy = false;
        }
    }

    /// <summary>
    /// Persists the team member type change for the selected team member.
    /// Updates the local copy on success so the list badge stays in sync.
    /// </summary>
    private async Task SaveMemberTeamMemberType()
    {
        if (selectedMember is null) return;
        memberTeamMemberTypeMessage = null;
        isBusy = true;
        try
        {
            // Only call updates for fields that actually changed. Treat unchanged fields as successful.
            var teamMemberTypeOk = true;
            var maxOk = true;

            var teamMemberTypeChanged = selectedMemberTeamMemberType != selectedMember.TeamMemberType;
            var maxChanged = selectedMemberMaxHours != (selectedMember.MaxHours);

            if (teamMemberTypeChanged)
            {
                teamMemberTypeOk = await UserService.UpdateTeamMemberTypeAsync(selectedMember.Username, selectedMemberTeamMemberType);
            }

            if (maxChanged)
            {
                maxOk = await UserService.UpdateMaxHoursAsync(selectedMember.Username, selectedMemberMaxHours);
            }

            // Consider operation successful if all attempted updates returned true.
            if ((teamMemberTypeChanged ? teamMemberTypeOk : true) && (maxChanged ? maxOk : true))
            {
                // Keep the in-memory list in sync so the list badge updates immediately
                selectedMember.TeamMemberType = selectedMemberTeamMemberType;
                selectedMember.MaxHours = selectedMemberMaxHours;
                memberTeamMemberTypeMessage = "Member updated.";
                memberTeamMemberTypeError = false;
            }
            else
            {
                // Partial or full failure. If DB was updated but the Update call returned false
                // (ModifiedCount == 0) treat that as success — query DB is the source of truth.
                // However, we can't call DB here; instead provide a clearer guidance message.
                memberTeamMemberTypeMessage = "Could not update all member values. Please try again.";
                memberTeamMemberTypeError = true;
            }
        }
        finally
        {
            isBusy = false;
        }
    }

