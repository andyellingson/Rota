    private List<WorkItem> rotationDayWorkItems =>
        selectedRotationDay.HasValue
            ? newRotationWorkItems.Where(s => s.WorkDay == selectedRotationDay.Value).ToList()
            : new List<WorkItem>();

    private string rotationDayTitle => selectedRotationDay.HasValue
        ? $"{selectedRotationDay.Value} WorkItems"
        : "Day work items";

    private void EditRotationWorkItem(WorkItem WorkItem)
    {
        showRotationDayModal = false;
        editingRotationWorkItem = WorkItem;
        createWorkItemForDay = WorkItem.WorkDay;
        newWorkItemDay = WorkItem.WorkDay ?? DayOfWeek.Monday;

        // Extract template wall-clock times exactly as stored.
        var startTime = TimeOnly.FromDateTime(WorkItem.Start);
        var endTime = TimeOnly.FromDateTime(WorkItem.End);

        // Initialize modal state with existing work item data
        rotationModalState.ShowModal = true;
        rotationModalState.ModalMode = ModalMode.WorkItem;
        rotationModalState.EditingWorkItem = WorkItem; // Set editing WorkItem so delete button appears
        rotationModalState.SelectedDate = DateOnly.FromDateTime(DateTime.Today); // Not used for templates but required
        rotationModalState.EditWorkItemDate = DateOnly.FromDateTime(DateTime.Today);
        rotationModalState.EditWorkItemstartTime = startTime;
        rotationModalState.EditWorkItemEndTime = endTime;
        rotationModalState.EditWorkItemTitle = WorkItem.Title ?? string.Empty;
        rotationModalState.EditWorkItemColor = WorkItem.Color ?? "#1890ff";
        rotationModalState.EditWorkItemNotes = WorkItem.Notes;
        rotationModalState.EditWorkItemWorkerType = WorkItem.WorkerType;
        rotationModalState.EditWorkItemAssignedTo = WorkItem.AssignedToUserId ?? string.Empty;
        rotationModalState.ModalError = null;
    }

    private void CloseRotationWorkItemModal()
    {
        rotationModalState.ShowModal = false;
        createWorkItemForDay = null;
        editingRotationWorkItem = null;
    }

    private async Task SaveRotationWorkItem()
    {
        if (!createWorkItemForDay.HasValue) return;

        if (editingRotationWorkItem != null)
        {
            // Update existing template work item
            editingRotationWorkItem.WorkDay = createWorkItemForDay.Value;
            // Create a reference date to store times (will be replaced when applying to calendar)
            var refDate = new DateTime(2000, 1, 1, 0, 0, 0, DateTimeKind.Utc);
            editingRotationWorkItem.Start = refDate.Add(rotationModalState.EditWorkItemstartTime.ToTimeSpan());
            editingRotationWorkItem.End = refDate.Add(rotationModalState.EditWorkItemEndTime.ToTimeSpan());
            editingRotationWorkItem.Title = string.IsNullOrWhiteSpace(rotationModalState.EditWorkItemTitle) ? "" : rotationModalState.EditWorkItemTitle.Trim();
            editingRotationWorkItem.Color = rotationModalState.EditWorkItemColor;
            editingRotationWorkItem.Notes = rotationModalState.EditWorkItemNotes;
            editingRotationWorkItem.WorkerType = rotationModalState.EditWorkItemWorkerType;
            editingRotationWorkItem.AssignedToUserId = string.IsNullOrWhiteSpace(rotationModalState.EditWorkItemAssignedTo) ? null : rotationModalState.EditWorkItemAssignedTo;
        }
        else
        {
            // Determine which days to create work items for based on recurrence
            var daysToCreate = new List<DayOfWeek>();

            switch (rotationModalState.NewWorkItemRecurrence)
            {
                case WorkItemRecurrence.None:
                    daysToCreate.Add(createWorkItemForDay.Value);
                    break;

                case WorkItemRecurrence.Daily:
                    // All 7 days
                    daysToCreate.AddRange(new[]
                    {
                        DayOfWeek.Sunday, DayOfWeek.Monday, DayOfWeek.Tuesday,
                        DayOfWeek.Wednesday, DayOfWeek.Thursday, DayOfWeek.Friday,
                        DayOfWeek.Saturday
                    });
                    break;

                case WorkItemRecurrence.Workdays:
                    // Monday through Friday
                    daysToCreate.AddRange(new[]
                    {
                        DayOfWeek.Monday, DayOfWeek.Tuesday, DayOfWeek.Wednesday,
                        DayOfWeek.Thursday, DayOfWeek.Friday
                    });
                    break;

                case WorkItemRecurrence.Weekends:
                    // Saturday and Sunday
                    daysToCreate.AddRange(new[] { DayOfWeek.Saturday, DayOfWeek.Sunday });
                    break;
            }

            // Create a template work item for each day
            // Note: RotationId will be set when SaveRotation is called
            foreach (var day in daysToCreate)
            {
                // Use a reference date to store the time (2000-01-01)
                var refDate = new DateTime(2000, 1, 1, 0, 0, 0, DateTimeKind.Utc);
                var start = refDate.Add(rotationModalState.NewWorkItemstartTime.ToTimeSpan());
                var end = refDate.Add(rotationModalState.NewWorkItemEndTime.ToTimeSpan());

                newRotationWorkItems.Add(new WorkItem
                {
                    Id = null,
                    WorkDay = day,
                    Start = start,
                    End = end,
                    Title = string.IsNullOrWhiteSpace(rotationModalState.NewWorkItemTitle) ? "" : rotationModalState.NewWorkItemTitle.Trim(),
                    Color = rotationModalState.NewWorkItemColor,
                    Notes = rotationModalState.NewWorkItemNotes,
                    WorkerType = rotationModalState.NewWorkItemWorkerType,
                    AssignedToUserId = string.IsNullOrWhiteSpace(rotationModalState.NewWorkItemAssignedTo) ? null : rotationModalState.NewWorkItemAssignedTo,
                    Username = _username ?? string.Empty,
                    ManagerCode = _managerCode,
                    ScheduleId = null, // Template WorkItems don't have ScheduleId
                    RotationId = null  // Will be set when SaveRotation creates the Rotation
                });
            }
        }

        CloseRotationWorkItemModal();
        StateHasChanged(); // Trigger change detection
        await Task.CompletedTask;
    }

    private async Task DeleteRotationWorkItem()
    {
        if (editingRotationWorkItem != null)
        {
            // Remove the work item from the template
            newRotationWorkItems.Remove(editingRotationWorkItem);
            CloseRotationWorkItemModal();
            StateHasChanged(); // Trigger change detection
        }

        await Task.CompletedTask;
    }

    private DateOnly StartOfWeek(DateOnly date)
    {
        var firstDay = CultureInfo.CurrentCulture.DateTimeFormat.FirstDayOfWeek;
        var diff = ((int)date.DayOfWeek - (int)firstDay + 7) % 7;
        return date.AddDays(-diff);
    }

    private void CloseRotationModal()
