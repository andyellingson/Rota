    private async Task OpenEditRotation(Rotation ww)
    {
        if (ww == null || string.IsNullOrEmpty(ww.Id) || string.IsNullOrEmpty(_managerCode)) return;

        editingRotation = ww;
        newRotationName = ww.Name;
        selectedRotationScheduleIds = ww.ScheduleIds.ToHashSet(StringComparer.Ordinal);
        showCreateRotation = true;
        showRotationModal = true;
        rotationModalState.ModalError = null;

        // Load existing template work items for this rotation
        try
        {
            newRotationWorkItems = await WorkItemsService.GetRotationTemplateWorkItemsAsync(ww.Id, _managerCode);
            // Store original values for change detection
            originalRotationName = ww.Name;
