            }).ToList();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading rotation work items");
            newRotationWorkItems = new List<WorkItem>();
            originalRotationWorkItems = new List<WorkItem>();
        }
    }

    private void CancelCreateRotation()
    {
        showCreateRotation = false;
        showRotationModal = false;
        editingRotation = null;
        newRotationName = string.Empty;
        selectedRotationScheduleIds.Clear();
        newRotationWorkItems.Clear();
        originalRotationName = string.Empty;
        originalRotationWorkItems.Clear();
    }

    private async Task SaveRotation()
    {
        rotationModalState.ModalError = null;
        if (string.IsNullOrEmpty(_managerCode))
        {
            rotationModalState.ModalError = "Your account does not have a manager code.";
            return;
        }
        if (string.IsNullOrWhiteSpace(newRotationName))
        {
            rotationModalState.ModalError = "Rotation name is required.";
            return;
        }
        if (selectedRotationScheduleIds.Count == 0)
        {
            rotationModalState.ModalError = "Select at least one schedule for this rotation.";
            return;
        }

        try
        {
            isBusy = true;
            var rotationId = editingRotation?.Id;

            if (editingRotation != null)
            {
                await WorkItemsService.DeleteRotationTemplateWorkItemsAsync(editingRotation.Id!, _managerCode);
                var updated = await RotationsService.UpdateAsync(editingRotation.Id!, _managerCode, newRotationName.Trim(), selectedRotationScheduleIds);
                if (updated is null)
                {
                    throw new InvalidOperationException("The rotation could not be updated. Its template work items were deleted; please retry saving the rotation.");
                }
            }
            else
            {
                var added = await RotationsService.CreateAsync(new Rotation
                {
                    Name = newRotationName.Trim(),
                    ScheduleIds = selectedRotationScheduleIds.ToList()
                }, _managerCode);
                rotationId = added.Id;
            }

            foreach (var templateWorkItem in newRotationWorkItems)
            {
                templateWorkItem.RotationId = rotationId;
                templateWorkItem.ManagerCode = _managerCode;
                templateWorkItem.Username = _username ?? string.Empty;
                templateWorkItem.ScheduleId = null;
                await WorkItemsService.CreateWorkItemAsync(templateWorkItem);
            }

            await LoadRotationsAsync();
            showCreateRotation = false;
            showRotationModal = false;
            editingRotation = null;
            newRotationName = string.Empty;
            selectedRotationScheduleIds.Clear();
            newRotationWorkItems.Clear();
            originalRotationName = string.Empty;
            originalRotationWorkItems.Clear();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error saving rotation");
            rotationModalState.ModalError = "The rotation could not be saved. Please try again.";
        }
        finally
        {
            isBusy = false;
        }
    }

    private async Task<bool> DeleteRotation(Rotation ww)
    {
        if (string.IsNullOrEmpty(_managerCode) || string.IsNullOrEmpty(ww.Id)) return false;

        try
        {
            isBusy = true;
            rotationModalState.ModalError = null;
            rotationListError = null;
            // Delete all template work items associated with this Rotation
            await WorkItemsService.DeleteRotationTemplateWorkItemsAsync(ww.Id!, _managerCode);

            var removed = await RotationsService.DeleteAsync(ww.Id, _managerCode);
            if (!removed)
            {
                throw new InvalidOperationException("The rotation could not be deleted. Its template work items were deleted, but its rotation record remains.");
            }

            await LoadRotationsAsync();
            return true;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error deleting rotation");
            rotationModalState.ModalError = ex is InvalidOperationException
                ? ex.Message
                : "The rotation could not be deleted because its template work items failed to delete. Please try again.";
            rotationListError = rotationModalState.ModalError;
            return false;
        }
        finally
        {
            isBusy = false;
        }
    }

    private async Task DeleteRotationFromList(Rotation rotation)
    {
        rotationListError = null;
        rotationToDelete = rotation;
        showDeleteRotationConfirm = true;
    }

    private void CloseDeleteRotationConfirm()
    {
        showDeleteRotationConfirm = false;
        rotationToDelete = null;
        rotationListError = null;
    }

    private async Task ConfirmDeleteRotation()
    {
        if (rotationToDelete == null) return;

        if (await DeleteRotation(rotationToDelete))
        {
            CloseDeleteRotationConfirm();
        }
    }

    private async Task DeleteCurrentRotation()
    {
        if (editingRotation == null) return;

        if (!await DeleteRotation(editingRotation)) return;
        showCreateRotation = false;
        showRotationModal = false;
        editingRotation = null;
        newRotationName = string.Empty;
        selectedRotationScheduleIds.Clear();
        newRotationWorkItems.Clear();
        originalRotationName = string.Empty;
        originalRotationWorkItems.Clear();
    }

    private bool CheckRotationChanges()
    {
        // For new rotations, enable save if name is not empty
        if (editingRotation == null)
        {
            return !string.IsNullOrWhiteSpace(newRotationName);
        }

        // For existing rotations, check if name or work items changed
        if (newRotationName != originalRotationName)
        {
            return true;
        }

        if (!selectedRotationScheduleIds.SetEquals(editingRotation.ScheduleIds))
        {
            return true;
        }

        // Check if work items changed (count, content, or order)
        if (newRotationWorkItems.Count != originalRotationWorkItems.Count)
        {
            return true;
        }

        // Deep comparison of work items
        for (int i = 0; i < newRotationWorkItems.Count; i++)
        {
            var current = newRotationWorkItems[i];
            var original = originalRotationWorkItems.FirstOrDefault(s => s.Id == current.Id);

            if (original == null ||
                current.WorkDay != original.WorkDay ||
                current.Start != original.Start ||
                current.End != original.End ||
                current.Title != original.Title ||
                current.Color != original.Color ||
                current.Notes != original.Notes ||
                current.WorkerType != original.WorkerType ||
                current.AssignedToUserId != original.AssignedToUserId)
            {
                return true;
            }
        }

        return false;
    }

    private void ToggleRotationSchedule(string? scheduleId, bool isSelected)
    {
        if (string.IsNullOrEmpty(scheduleId)) return;
        if (isSelected) selectedRotationScheduleIds.Add(scheduleId);
        else selectedRotationScheduleIds.Remove(scheduleId);
    }

    private void OnRotationChanged()
    {
        // Trigger re-render to update button state
        StateHasChanged();
